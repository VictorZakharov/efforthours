    "source": [
      "import httpx\n",
      "\n",
      "def normalize(value):\n",
      "    return value.strip().lower()\n",
      "\n",
      "def load_status(endpoint):\n",
      "    response = httpx.get(endpoint)\n",
      "    response.raise_for_status()\n",
      "    return response.json()\n"
    ],
