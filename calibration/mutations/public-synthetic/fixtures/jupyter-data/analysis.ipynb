    "source": [
      "import pandas as pd\n",
      "\n",
      "def normalize(value):\n",
      "    return value.strip().lower()\n",
      "\n",
      "def summarize(values):\n",
      "    frame = pd.DataFrame({\"value\": values})\n",
      "    return frame.groupby(\"value\").size()\n"
    ],
