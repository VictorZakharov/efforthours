    "source": [
      "def normalize(value):\n",
      "    return value.strip().lower()\n",
      "\n",
      "async def normalize_many(values):\n",
      "    if not values:\n",
      "        return []\n",
      "    return [normalize(value) for value in values]\n"
    ],
