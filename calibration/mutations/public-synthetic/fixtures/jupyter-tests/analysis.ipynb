    "source": [
      "import pytest\n",
      "\n",
      "def normalize(value):\n",
      "    return value.strip().lower()\n",
      "\n",
      "@pytest.mark.parametrize(\"value, expected\", [(\" Ready \", \"ready\"), (\"GO\", \"go\")])\n",
      "def test_normalize(value, expected):\n",
      "    assert normalize(value) == expected\n"
