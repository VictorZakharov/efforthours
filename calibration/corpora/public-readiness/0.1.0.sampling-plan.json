      "bin",
      "coverage",
      "dist",
      "external",
      "externals",
      "generated",
      "node_modules",
      "obj",
      "out",
      "third-party",
      "third_party",
      "vendor",
      "vendors"
    ],
    "excludedPathSequences": [
      "wwwroot/lib",
      "wwwroot/vendor"
    ],
    "bands": [
      {
        "id": "small",
        "minimumFiles": 0,
        "maximumFiles": 249
      },
      {
        "id": "medium",
        "minimumFiles": 250,
        "maximumFiles": 1999
      },
      {
        "id": "large",
        "minimumFiles": 2000,
        "maximumFiles": null
      }
    ]
  },
