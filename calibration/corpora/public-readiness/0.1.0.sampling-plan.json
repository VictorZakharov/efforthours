  "methodology": {
    "sourceBoundary": "Public immutable Git trees and license files only; source archives and source bodies are not redistributed.",
    "candidateBoundary": "No EffortHours evidence bundle, estimate report, candidate total, work-item range, or evaluation was generated or inspected while selecting this cohort.",
    "developmentBoundary": "Development labels may be authored after this freeze and are the only labels available for feature design or fitting.",
    "validationBoundary": "Validation labels must be authored blind and remain unavailable until a finite candidate manifest is frozen.",
    "testBoundary": "Test labels must be authored blind, sealed with a precommitted digest and custody record, and revealed only for the one-time selected-candidate decision.",
    "reviewBoundary": "Any future labels start as teacher-estimate weak supervision under ehe-work-item/1.1.0 until a genuinely distinct review changes their maturity.",
    "forbiddenSignals": [
      "candidate hours, ranges, confidence, categories, explanations, or totals during source selection",
      "actual labor, elapsed time, contributor identity, activity, commit count, churn, or repository age",
      "pricing, popularity, stars, forks, issue volume, or a preferred aggregate result"
    ]
  },
  "sizeMetric": {
    "id": "repository-source-shape-file-count/1.0.0",
