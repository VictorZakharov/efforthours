<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <RootNamespace>EffortHours.Cli</RootNamespace>
    <AssemblyName>efforthours</AssemblyName>
    <Description>Estimate equivalent non-AI human effort in repositories and completed changes with evidence-backed, offline static analysis.</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>eh</ToolCommandName>
    <PackageId>EffortHours.Tool</PackageId>
    <Version>0.10.0-alpha.13</Version>
    <Title>EffortHours CLI</Title>
    <PackageReadmeFile>PACKAGE_README.md</PackageReadmeFile>
    <PackageTags>estimation;effort-estimation;developer-tools;cli;repository-analysis;static-analysis;dotnet-tool</PackageTags>
    <PackageReleaseNotes>0.10.0-alpha.13: Author-period manifests can now preflight exact repository scope as versioned JSON or Markdown before analysis, replace the ordinary 10,000-candidate rejection with deterministic memory and emergency safety budgets, and expose resource accounting for large runs. Time-bucketed comparisons add isolated, membership-stable contributor trends while preserving joint reconciliation as the authoritative portfolio total. Large report validation is now bounded, calendar capacity and schema diagnostics are clearer, and checkpoint scope plus output accounting are exact. Repository EHE remains experimental and uncalibrated, and seed-rules/0.4.0 remains the shipped estimator. Full notes: https://github.com/VictorZakharov/efforthours/blob/v0.10.0-alpha.13/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../EffortHours.Analysis/EffortHours.Analysis.csproj" />
    <ProjectReference Include="../EffortHours.Calibration/EffortHours.Calibration.csproj" />
    <ProjectReference Include="../EffortHours.Change/EffortHours.Change.csproj" />
    <ProjectReference Include="../EffortHours.Contracts/EffortHours.Contracts.csproj" />
    <ProjectReference Include="../EffortHours.Core/EffortHours.Core.csproj" />
    <ProjectReference Include="../EffortHours.Estimation/EffortHours.Estimation.csproj" />
    <ProjectReference Include="../EffortHours.Pricing/EffortHours.Pricing.csproj" />
    <ProjectReference Include="../EffortHours.Reporting/EffortHours.Reporting.csproj" />
    <ProjectReference Include="../EffortHours.Review/EffortHours.Review.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../models/seed-rules/0.4.0.json" Pack="true" PackagePath="models/seed-rules/" />
    <None Include="../../rates/us-senior-contractor/2026.1.json" Pack="true" PackagePath="rates/us-senior-contractor/" />
    <None Include="../../PACKAGE_README.md" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup Condition="'$(RepositoryCandidateMeasurement)' == 'true'">
    <None Include="../../calibration/corpora/public-readiness/1.0.0.logical-capability-model.json"
          Pack="true"
          PackagePath="models/repository-candidates/" />
    <None Include="../../tools/EffortHours.RepositoryCalibration/bin/$(Configuration)/net10.0/EffortHours.RepositoryCalibration.dll"
          Pack="true"
          PackagePath="tools/net10.0/any/candidate-runtime/" />
  </ItemGroup>
</Project>
