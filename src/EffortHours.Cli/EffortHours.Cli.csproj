<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <RootNamespace>EffortHours.Cli</RootNamespace>
    <AssemblyName>efforthours</AssemblyName>
    <Description>Estimate equivalent non-AI human effort in repositories and completed changes with evidence-backed, offline static analysis.</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>eh</ToolCommandName>
    <PackageId>EffortHours.Tool</PackageId>
    <Version>0.10.0-alpha.42</Version>
    <Title>EffortHours CLI</Title>
    <PackageReadmeFile>PACKAGE_README.md</PackageReadmeFile>
    <PackageTags>estimation;effort-estimation;developer-tools;cli;repository-analysis;static-analysis;dotnet-tool</PackageTags>
    <PackageReleaseNotes>0.10.0-alpha.42: Bundle complete installed-version documentation and synthetic historical-refresh examples with offline eh docs list/show/export commands. Replace CLI documentation pointers with offline topic commands. Give check-refresh native exits 0 for ready, 3 for blocked and 1 for invalid input or expected operational failure; preserve usage 2 and cancellation 130 and document PowerShell exit propagation. Include the complete historical-refresh integration contract and tested conditional note adapter. EHE values, fixed-eight allocation, rounding and rates are unchanged. EHE remains experimental and uncalibrated; original workdays remain unresolved without external evidence. No time-entry writes. Full notes: https://github.com/VictorZakharov/efforthours/blob/v0.10.0-alpha.42/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../EffortHours.Analysis/EffortHours.Analysis.csproj" />
    <ProjectReference Include="../EffortHours.Calibration/EffortHours.Calibration.csproj" />
    <ProjectReference Include="../EffortHours.Change/EffortHours.Change.csproj" />
    <ProjectReference Include="../EffortHours.Contracts/EffortHours.Contracts.csproj" />
    <ProjectReference Include="../EffortHours.Core/EffortHours.Core.csproj" />
    <ProjectReference Include="../EffortHours.Estimation/EffortHours.Estimation.csproj" />
    <ProjectReference Include="../EffortHours.Pricing/EffortHours.Pricing.csproj" />
    <ProjectReference Include="../EffortHours.Reporting/EffortHours.Reporting.csproj" />
    <ProjectReference Include="../EffortHours.Review/EffortHours.Review.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../integrations/codex/efforthours/SKILL.md"
                      LogicalName="EffortHours.Cli.Integrations.Codex.EffortHours.SKILL.md" />
    <None Include="../../integrations/codex/efforthours/SKILL.md"
          Pack="true"
          PackagePath="integrations/codex/efforthours/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../models/seed-rules/0.4.0.json" Pack="true" PackagePath="models/seed-rules/" />
    <None Include="../../rates/us-senior-contractor/2026.1.json" Pack="true" PackagePath="rates/us-senior-contractor/" />
    <None Include="../../PACKAGE_README.md" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../docs/*.md"
                      LogicalName="EffortHours.Cli.Documentation.docs/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../README.md;../../CHANGELOG.md;../../LICENSE;../../THIRD-PARTY-NOTICES.md"
                      LogicalName="EffortHours.Cli.Documentation.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../examples/historical-refresh/*.md;../../examples/historical-refresh/*.json;../../examples/historical-refresh/*.cs"
                      LogicalName="EffortHours.Cli.Documentation.examples/historical-refresh/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup Condition="'$(RepositoryCandidateMeasurement)' == 'true'">
    <None Include="../../calibration/corpora/public-readiness/1.0.0.logical-capability-model.json"
          Pack="true"
          PackagePath="models/repository-candidates/" />
    <None Include="../../tools/EffortHours.RepositoryCalibration/bin/$(Configuration)/net10.0/EffortHours.RepositoryCalibration.dll"
          Pack="true"
          PackagePath="tools/net10.0/any/candidate-runtime/" />
  </ItemGroup>
</Project>
