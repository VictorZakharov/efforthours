<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Versioned public contracts and JSON Schemas for EffortHours evidence and estimates.</Description>
    <RootNamespace>EffortHours.Contracts</RootNamespace>
    <AssemblyName>EffortHours.Contracts</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../schemas/v1/*.schema.json">
      <LogicalName>EffortHours.Schemas.V1.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
