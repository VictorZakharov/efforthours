<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Fairbill.Cli</RootNamespace>
    <AssemblyName>fairbill</AssemblyName>
    <Description>Estimate equivalent non-AI human effort represented by a software repository.</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>fairbill</ToolCommandName>
    <PackageId>Fairbill.Tool</PackageId>
    <Version>0.7.0-alpha.1</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>estimation;developer-tools;cli;repository-analysis</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Fairbill.Analysis/Fairbill.Analysis.csproj" />
    <ProjectReference Include="../Fairbill.Calibration/Fairbill.Calibration.csproj" />
    <ProjectReference Include="../Fairbill.Contracts/Fairbill.Contracts.csproj" />
    <ProjectReference Include="../Fairbill.Core/Fairbill.Core.csproj" />
    <ProjectReference Include="../Fairbill.Estimation/Fairbill.Estimation.csproj" />
    <ProjectReference Include="../Fairbill.Pricing/Fairbill.Pricing.csproj" />
    <ProjectReference Include="../Fairbill.Reporting/Fairbill.Reporting.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../models/seed-rules/0.2.0.json" Pack="true" PackagePath="models/seed-rules/" />
    <None Include="../../rates/us-senior-contractor/2026.1.json" Pack="true" PackagePath="rates/us-senior-contractor/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
