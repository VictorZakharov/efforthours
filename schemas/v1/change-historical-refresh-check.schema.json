{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eh:schema:v1:change-historical-refresh-check",
  "title": "EffortHours historical refresh read-only preflight v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policy",
    "dryRun",
    "requiresEntryConfirmation",
    "status",
    "planDigest",
    "plan",
    "current",
    "unexpectedRecordIds",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "policy": {
      "const": "historical-refresh-preflight/1.0.0"
    },
    "dryRun": {
      "const": true
    },
    "requiresEntryConfirmation": {
      "const": true
    },
    "status": {
      "enum": [
        "blocked",
        "ready-for-confirmation"
      ]
    },
    "planDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "plan": {
      "$ref": "urn:eh:schema:v1:change-historical-refresh-plan"
    },
    "current": {
      "$ref": "urn:eh:schema:v1:change-historical-refresh-current"
    },
    "unexpectedRecordIds": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "recordId",
          "originalRecordDigest",
          "snapshotStatus",
          "noteStatus",
          "eheStatus"
        ],
        "properties": {
          "recordId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "originalRecordDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "currentRecordDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "proposedNoteRecordDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "snapshotStatus": {
            "enum": [
              "missing-record",
              "original-match",
              "planned-note-match",
              "concurrent-edit"
            ]
          },
          "noteStatus": {
            "enum": [
              "not-requested",
              "ready-to-set",
              "already-current",
              "blocked-missing-record",
              "blocked-concurrent-edit",
              "blocked-locked",
              "blocked-invoiced",
              "blocked-unknown",
              "blocked-permission-denied",
              "blocked-permission-unknown",
              "blocked-managed-annotation",
              "blocked-unresolved-attribution",
              "blocked-description-bound",
              "blocked-unresolved-matching"
            ]
          },
          "eheStatus": {
            "enum": [
              "not-requested",
              "ready-to-set",
              "already-current",
              "blocked-missing-record",
              "blocked-concurrent-edit",
              "blocked-locked",
              "blocked-invoiced",
              "blocked-unknown",
              "blocked-permission-denied",
              "blocked-permission-unknown",
              "blocked-managed-annotation",
              "blocked-unresolved-attribution",
              "blocked-description-bound",
              "blocked-unresolved-matching"
            ]
          }
        }
      }
    }
  }
}
