{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eh:schema:v1:calibration-manual-qa-decision-policy",
  "title": "EffortHours manual-QA development decision compiler policy v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "policyVersion",
    "id",
    "compilerVersion",
    "authoringVersion",
    "licenseExpression",
    "maturity",
    "planId",
    "planVersion",
    "planDescription",
    "sourceCorpus",
    "reviewPolicy",
    "reviewManifest",
    "reviewRubric",
    "outputCorpus",
    "partition",
    "profile",
    "baselineId",
    "replacedCategory",
    "sourceWorkItemLineageVersion",
    "expectedRecordCount",
    "expectedDecisionCount",
    "expectedRemovedTargetCount",
    "expectedPreservedTargetCount",
    "expectedOutputTargetCount",
    "requiredDecisionPractices",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "policyVersion": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "minLength": 1 },
    "compilerVersion": { "type": "string", "minLength": 1 },
    "authoringVersion": { "type": "string", "minLength": 1 },
    "licenseExpression": { "const": "MIT" },
    "maturity": { "type": "string", "minLength": 1 },
    "planId": { "type": "string", "minLength": 1 },
    "planVersion": { "type": "string", "minLength": 1 },
    "planDescription": { "type": "string", "minLength": 1 },
    "sourceCorpus": { "$ref": "#/$defs/corpusReference" },
    "reviewPolicy": { "$ref": "#/$defs/policyReference" },
    "reviewManifest": { "$ref": "#/$defs/manifestReference" },
    "reviewRubric": { "$ref": "#/$defs/rubric" },
    "outputCorpus": { "$ref": "#/$defs/outputCorpus" },
    "partition": { "const": "development" },
    "profile": { "const": "implementation" },
    "baselineId": { "type": "string", "minLength": 1 },
    "replacedCategory": { "const": "manual-validation-debugging-and-hardening" },
    "sourceWorkItemLineageVersion": { "type": "string", "minLength": 1 },
    "expectedRecordCount": { "type": "integer", "minimum": 1 },
    "expectedDecisionCount": { "type": "integer", "minimum": 1 },
    "expectedRemovedTargetCount": { "type": "integer", "minimum": 1 },
    "expectedPreservedTargetCount": { "type": "integer", "minimum": 1 },
    "expectedOutputTargetCount": { "type": "integer", "minimum": 1 },
    "requiredDecisionPractices": { "$ref": "#/$defs/nonEmptyStrings" },
    "limitations": { "$ref": "#/$defs/nonEmptyStrings" }
  },
  "additionalProperties": false,
  "$defs": {
    "corpusReference": {
      "type": "object",
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "policyReference": {
      "type": "object",
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "manifestReference": {
      "type": "object",
      "required": ["version", "digest"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "rubric": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "outputCorpus": {
      "type": "object",
      "required": ["id", "version", "description", "rubric"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "rubric": { "$ref": "#/$defs/rubric" }
      },
      "additionalProperties": false
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
