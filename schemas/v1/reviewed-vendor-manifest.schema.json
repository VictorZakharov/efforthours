{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eh:schema:v1:reviewed-vendor-manifest",
  "title": "Reviewed vendor manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "protocolVersion", "files"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "protocolVersion": { "const": "reviewed-vendor-manifest/1.0.0" },
    "files": {
      "type": "array", "minItems": 1, "maxItems": 4096,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "classification", "library", "provenance", "rationale"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "classification": { "const": "third-party-body" },
          "library": { "type": "string", "minLength": 1, "maxLength": 256 },
          "provenance": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "rationale": { "type": "string", "minLength": 1, "maxLength": 2048 }
        }
      }
    }
  }
}
