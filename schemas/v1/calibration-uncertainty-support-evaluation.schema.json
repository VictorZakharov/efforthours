{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eh:schema:v1:calibration-uncertainty-support-evaluation",
  "title": "EffortHours calibration uncertainty support evaluation report v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "evaluatorVersion",
    "metricVersion",
    "corpusId",
    "corpusVersion",
    "corpusDigest",
    "partition",
    "sourceEvaluationDigest",
    "supportProfileDigest",
    "supportProfilerVersion",
    "supportPolicyVersion",
    "supportPopulationId",
    "supportPopulationVersion",
    "supportPopulationDigest",
    "featureContractVersion",
    "featureContractDigest",
    "intervalPolicyVersion",
    "projectorVersions",
    "estimatorVersions",
    "profile",
    "baselineId",
    "protocol",
    "summary",
    "currentIntervals",
    "crossValidatedBaseline",
    "signals",
    "repositories",
    "targets"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "evaluatorVersion": { "const": "uncertainty-support-evaluator/1.0.0" },
    "metricVersion": { "const": "uncertainty-support-metrics/1.0.0" },
    "corpusId": { "type": "string", "minLength": 1 },
    "corpusVersion": { "type": "string", "minLength": 1 },
    "corpusDigest": { "$ref": "#/$defs/digest" },
    "partition": { "const": "development" },
    "sourceEvaluationDigest": { "$ref": "#/$defs/digest" },
    "supportProfileDigest": { "$ref": "#/$defs/digest" },
    "supportProfilerVersion": { "const": "uncertainty-support-profiler/1.0.0" },
    "supportPolicyVersion": { "const": "uncertainty-support-policy/1.0.0" },
    "supportPopulationId": { "type": "string", "minLength": 1 },
    "supportPopulationVersion": { "type": "string", "minLength": 1 },
    "supportPopulationDigest": { "$ref": "#/$defs/digest" },
    "featureContractVersion": { "const": "repository-uncertainty-features/1.0.0" },
    "featureContractDigest": {
      "const": "sha256:a2fea34b25d0c963bb9e96d8c538e130f6b2b23d4d98d851584a7fbe69916077"
    },
    "intervalPolicyVersion": { "const": "symmetric-planning-interval/1.0.0" },
    "projectorVersions": { "$ref": "#/$defs/stringList" },
    "estimatorVersions": { "$ref": "#/$defs/stringList" },
    "profile": { "enum": ["implementation", "recreation"] },
    "baselineId": { "type": "string", "minLength": 1 },
    "protocol": { "$ref": "#/$defs/protocol" },
    "summary": { "$ref": "#/$defs/summary" },
    "currentIntervals": {
      "$ref": "urn:eh:schema:v1:calibration-uncertainty-evaluation#/$defs/performance"
    },
    "crossValidatedBaseline": {
      "$ref": "urn:eh:schema:v1:calibration-uncertainty-evaluation#/$defs/performance"
    },
    "signals": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "urn:eh:schema:v1:calibration-uncertainty-evaluation#/$defs/feature"
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "urn:eh:schema:v1:calibration-uncertainty-evaluation#/$defs/repository"
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/target" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "protocol": {
      "type": "object",
      "required": [
        "version",
        "partition",
        "foldUnit",
        "targetMetric",
        "normalization",
        "normalizationFloorHours",
        "intendedCoverageTarget",
        "quantileMethod",
        "minimumBucketObservationCount",
        "minimumBucketRepositoryCount",
        "targetAggregationVersion",
        "outOfDistributionBucketPolicy",
        "repositoryIsolated",
        "supportProfileLabelIndependent",
        "developmentOnly",
        "fitsProductionModel",
        "formalProbabilityInterval"
      ],
      "properties": {
        "version": { "const": "uncertainty-support-evaluation/1.0.0" },
        "partition": { "const": "development" },
        "foldUnit": { "const": "repository" },
        "targetMetric": { "const": "absolute-reviewed-expected-residual" },
        "normalization": { "const": "candidate-expected-with-0.5-hour-floor" },
        "normalizationFloorHours": { "const": 0.5 },
        "intendedCoverageTarget": { "const": 0.8 },
        "quantileMethod": { "const": "nearest-rank" },
        "minimumBucketObservationCount": { "const": 3 },
        "minimumBucketRepositoryCount": { "const": 2 },
        "targetAggregationVersion": {
          "const": "uncertainty-support-target-aggregation/1.0.0"
        },
        "outOfDistributionBucketPolicy": {
          "const": "exact-0;very-near-0.008333;near-0.025;moderate-0.05;elevated-0.1;high"
        },
        "repositoryIsolated": { "const": true },
        "supportProfileLabelIndependent": { "const": true },
        "developmentOnly": { "const": true },
        "fitsProductionModel": { "const": false },
        "formalProbabilityInterval": { "const": false }
      },
      "additionalProperties": false
    },
    "supportLevel": {
      "enum": ["exact", "category-size-ecosystem", "category-size", "category", "global"]
    },
    "target": {
      "type": "object",
      "required": [
        "source",
        "sourceWorkItemCount",
        "worstSupportLevel",
        "worstSupportDepth",
        "supportSufficient",
        "minimumSelectedSupportObservationCount",
        "minimumSelectedSupportRepositoryCount",
        "expectedWeightedOutOfDistributionScore",
        "maximumOutOfDistributionScore"
      ],
      "properties": {
        "source": {
          "$ref": "urn:eh:schema:v1:calibration-uncertainty-evaluation#/$defs/target"
        },
        "sourceWorkItemCount": { "type": "integer", "minimum": 1 },
        "worstSupportLevel": { "$ref": "#/$defs/supportLevel" },
        "worstSupportDepth": { "type": "integer", "minimum": 0, "maximum": 5 },
        "supportSufficient": { "type": "boolean" },
        "minimumSelectedSupportObservationCount": { "type": "integer", "minimum": 0 },
        "minimumSelectedSupportRepositoryCount": { "type": "integer", "minimum": 0 },
        "expectedWeightedOutOfDistributionScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maximumOutOfDistributionScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "recordCount",
        "repositoryCount",
        "featureReportCount",
        "targetCount",
        "matchedTargetCount",
        "sourceWorkItemReferenceCount",
        "matchedSourceWorkItemReferenceCount",
        "supportProfileWorkItemCount",
        "matchedSupportWorkItemReferenceCount",
        "signalCount"
      ],
      "properties": {
        "recordCount": { "type": "integer", "minimum": 3 },
        "repositoryCount": { "type": "integer", "minimum": 3 },
        "featureReportCount": { "type": "integer", "minimum": 3 },
        "targetCount": { "type": "integer", "minimum": 1 },
        "matchedTargetCount": { "type": "integer", "minimum": 1 },
        "sourceWorkItemReferenceCount": { "type": "integer", "minimum": 1 },
        "matchedSourceWorkItemReferenceCount": { "type": "integer", "minimum": 1 },
        "supportProfileWorkItemCount": { "type": "integer", "minimum": 1 },
        "matchedSupportWorkItemReferenceCount": { "type": "integer", "minimum": 1 },
        "signalCount": { "const": 4 }
      },
      "additionalProperties": false
    }
  }
}
