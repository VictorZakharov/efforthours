{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eh:schema:v1:calibration-review-plan",
  "title": "EffortHours completed calibration review plan v1",
  "type": "object",
  "required": ["schemaVersion", "compilerVersion", "id", "version", "description", "rubric", "records"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "compilerVersion": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "rubric": { "$ref": "#/$defs/rubric" },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "rubric": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "required": [
        "id",
        "repository",
        "profile",
        "baselineId",
        "partition",
        "sourceEstimatorVersion",
        "sourceEstimateDigest",
        "source",
        "review",
        "capabilities"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "repository": { "$ref": "#/$defs/repository" },
        "change": { "$ref": "#/$defs/change" },
        "profile": { "$ref": "#/$defs/profile" },
        "baselineId": { "type": "string", "minLength": 1 },
        "partition": { "$ref": "#/$defs/partition" },
        "sourceEstimatorVersion": { "type": "string", "minLength": 1 },
        "sourceEstimateDigest": { "type": "string", "pattern": "^sha256:.+" },
        "source": { "$ref": "#/$defs/source" },
        "review": { "$ref": "#/$defs/review" },
        "capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/capability" }
        }
      },
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "required": ["id", "name", "sourceDigest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "sourceDigest": { "type": "string", "pattern": "^sha256:.+" }
      },
      "additionalProperties": false
    },
    "change": {
      "type": "object",
      "required": [
        "id",
        "selectionKind",
        "baseObjectId",
        "headObjectId",
        "baseEvidenceDigest",
        "headEvidenceDigest",
        "finalDeltaDigest",
        "coverageTags"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "selectionKind": { "enum": ["base-head", "commit", "range", "pull-request"] },
        "baseObjectId": { "type": "string", "minLength": 1 },
        "headObjectId": { "type": "string", "minLength": 1 },
        "baseEvidenceDigest": { "type": "string", "pattern": "^sha256:.+" },
        "headEvidenceDigest": { "type": "string", "pattern": "^sha256:.+" },
        "finalDeltaDigest": { "type": "string", "pattern": "^sha256:.+" },
        "coverageTags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "dataClassification",
        "sourceReference",
        "revision",
        "licenseExpression",
        "redistributionAllowed"
      ],
      "properties": {
        "dataClassification": {
          "enum": ["public-redistributable", "private", "synthetic"]
        },
        "sourceReference": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "licenseExpression": { "type": "string", "minLength": 1 },
        "redistributionAllowed": { "type": "boolean" },
        "notes": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": ["status", "completedOn", "reviewers"],
      "properties": {
        "status": { "enum": ["teacher-estimate", "reviewed", "adjudicated"] },
        "completedOn": { "type": "string", "format": "date" },
        "reviewers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/reviewer" }
        },
        "notes": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "reviewer": {
      "type": "object",
      "required": ["id", "kind", "role"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["human", "host-ai"] },
        "role": { "enum": ["teacher", "reviewer", "adjudicator"] },
        "modelId": { "type": "string", "minLength": 1 },
        "modelVersion": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "required": ["sourceCapabilityId", "rationale", "targets"],
      "properties": {
        "sourceCapabilityId": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/target" }
        }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": ["hours", "uncertaintyReasons"],
      "properties": {
        "hours": { "$ref": "#/$defs/effortRange" },
        "uncertaintyReasons": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "sizeException": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "effortRange": {
      "type": "object",
      "required": ["low", "expected", "high"],
      "properties": {
        "low": { "type": "number", "minimum": 0 },
        "expected": { "type": "number", "minimum": 0 },
        "high": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "profile": { "enum": ["implementation", "recreation"] },
    "partition": { "enum": ["development", "validation", "test"] }
  }
}
