{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fairbill:schema:v1:calibration-validation",
  "title": "Fairbill calibration validation summary v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "corpusId",
    "corpusVersion",
    "valid",
    "recordCount",
    "repositoryCount",
    "partitions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "corpusId": {
      "type": "string",
      "minLength": 1
    },
    "corpusVersion": {
      "type": "string",
      "minLength": 1
    },
    "valid": {
      "const": true
    },
    "recordCount": {
      "type": "integer",
      "minimum": 1
    },
    "repositoryCount": {
      "type": "integer",
      "minimum": 1
    },
    "partitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "partition",
          "recordCount",
          "repositoryCount"
        ],
        "properties": {
          "partition": {
            "enum": [
              "development",
              "validation",
              "test"
            ]
          },
          "recordCount": {
            "type": "integer",
            "minimum": 1
          },
          "repositoryCount": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
