{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eh:schema:v1:change-workday-allocation-report",
  "title": "EffortHours declared workday EHE allocation v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "policy",
    "status",
    "sourceSemanticDigest",
    "sourcePortfolioDigest",
    "workdayInputDigest",
    "timeZone",
    "contributorId",
    "sourceEstimatorVersion",
    "totalEffort",
    "categories",
    "days",
    "boundary"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "policy": {
      "const": "equal-declared-days/1.0.0"
    },
    "status": {
      "const": "allocated"
    },
    "sourceSemanticDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sourcePortfolioDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "workdayInputDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timeZone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "contributorId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "sourceEstimatorVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "totalEffort": {
      "$ref": "#/$defs/effortRange"
    },
    "totalCapacityHours": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "categories": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/categoryEstimate"
      }
    },
    "days": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/day"
      },
      "minItems": 1
    },
    "boundary": {
      "const": "Experimental, uncalibrated EHE allocation; declared dates are not recovered Git workdays, actual labor, productivity, or timesheet entries. Logged hours do not set EHE weights or reference capacity."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "effortRange": {
      "type": "object",
      "required": [
        "low",
        "expected",
        "high"
      ],
      "properties": {
        "low": {
          "type": "number",
          "minimum": 0
        },
        "expected": {
          "type": "number",
          "minimum": 0
        },
        "high": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "category": {
      "enum": [
        "specification-comprehension-and-domain-learning",
        "repository-and-solution-setup",
        "architecture-and-technical-design",
        "production-implementation",
        "ui-implementation-and-represented-ux-decisions",
        "data-modeling-persistence-and-migrations",
        "external-integrations-and-protocols",
        "unit-testing",
        "integration-contract-and-component-testing",
        "end-to-end-and-ui-testing",
        "manual-validation-debugging-and-hardening",
        "documentation",
        "build-configuration-and-developer-tooling",
        "ci-cd-and-infrastructure-as-code",
        "security-and-accessibility",
        "packaging-deployment-and-release-artifacts",
        "self-review-and-system-integration"
      ]
    },
    "categoryEstimate": {
      "type": "object",
      "required": [
        "category",
        "hours"
      ],
      "properties": {
        "category": {
          "$ref": "#/$defs/category"
        },
        "hours": {
          "$ref": "#/$defs/effortRange"
        }
      },
      "additionalProperties": false
    },
    "ratio": {
      "type": "object",
      "required": [
        "low",
        "expected",
        "high"
      ],
      "properties": {
        "low": {
          "type": "number",
          "minimum": 0
        },
        "expected": {
          "type": "number",
          "minimum": 0
        },
        "high": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "day": {
      "type": "object",
      "required": [
        "date",
        "bucketId",
        "status",
        "originalWorkdayStatus",
        "sourceAttributedEffort",
        "allocatedEffort",
        "categories"
      ],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "format": "date"
        },
        "bucketId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "recordId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "const": "allocated"
        },
        "originalWorkdayStatus": {
          "const": "unresolved-original-workday"
        },
        "sourceAttributedEffort": {
          "$ref": "#/$defs/effortRange"
        },
        "allocatedEffort": {
          "$ref": "#/$defs/effortRange"
        },
        "capacityHours": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "capacityRatio": {
          "anyOf": [
            {
              "$ref": "#/$defs/ratio"
            },
            {
              "type": "null"
            }
          ]
        },
        "categories": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/categoryEstimate"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
