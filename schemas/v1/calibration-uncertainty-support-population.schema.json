{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eh:schema:v1:calibration-uncertainty-support-population",
  "title": "EffortHours calibration uncertainty support population v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "manifestVersion",
    "id",
    "version",
    "description",
    "partition",
    "featureContractVersion",
    "featureContractDigest",
    "profile",
    "baselineId",
    "repositories"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "manifestVersion": { "const": "uncertainty-support-population/1.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "partition": { "const": "development" },
    "featureContractVersion": { "const": "repository-uncertainty-features/1.0.0" },
    "featureContractDigest": {
      "const": "sha256:a2fea34b25d0c963bb9e96d8c538e130f6b2b23d4d98d851584a7fbe69916077"
    },
    "profile": { "enum": ["implementation", "recreation"] },
    "baselineId": { "type": "string", "minLength": 1 },
    "repositories": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/repository" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "repository": {
      "type": "object",
      "required": ["recordId", "repositoryId", "sourceDigest"],
      "properties": {
        "recordId": { "type": "string", "minLength": 1 },
        "repositoryId": { "type": "string", "minLength": 1 },
        "sourceDigest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    }
  }
}
