{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eh:schema:v1:calibration-uncertainty-evaluation",
  "title": "EffortHours calibration uncertainty evaluation report v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "evaluatorVersion",
    "metricVersion",
    "corpusId",
    "corpusVersion",
    "corpusDigest",
    "partition",
    "featureContractVersion",
    "featureContractDigest",
    "intervalPolicyVersion",
    "projectorVersions",
    "estimatorVersions",
    "protocol",
    "summary",
    "currentIntervals",
    "crossValidatedBaseline",
    "features",
    "slices",
    "repositories",
    "targets"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "evaluatorVersion": { "const": "uncertainty-feature-evaluator/1.0.0" },
    "metricVersion": { "const": "uncertainty-feature-metrics/1.0.0" },
    "corpusId": { "type": "string", "minLength": 1 },
    "corpusVersion": { "type": "string", "minLength": 1 },
    "corpusDigest": { "$ref": "#/$defs/digest" },
    "partition": { "const": "development" },
    "featureContractVersion": { "const": "repository-uncertainty-features/1.0.0" },
    "featureContractDigest": {
      "const": "sha256:a2fea34b25d0c963bb9e96d8c538e130f6b2b23d4d98d851584a7fbe69916077"
    },
    "intervalPolicyVersion": { "const": "symmetric-planning-interval/1.0.0" },
    "projectorVersions": { "$ref": "#/$defs/stringList" },
    "estimatorVersions": { "$ref": "#/$defs/stringList" },
    "protocol": { "$ref": "#/$defs/protocol" },
    "summary": { "$ref": "#/$defs/summary" },
    "currentIntervals": { "$ref": "#/$defs/performance" },
    "crossValidatedBaseline": { "$ref": "#/$defs/performance" },
    "features": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": { "$ref": "#/$defs/feature" }
    },
    "slices": {
      "type": "array",
      "items": { "$ref": "#/$defs/slice" }
    },
    "repositories": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/repository" }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/target" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "protocol": {
      "type": "object",
      "required": [
        "version",
        "partition",
        "foldUnit",
        "targetMetric",
        "normalization",
        "normalizationFloorHours",
        "intendedCoverageTarget",
        "quantileMethod",
        "minimumBucketObservationCount",
        "minimumBucketRepositoryCount",
        "repositoryIsolated",
        "developmentOnly",
        "fitsProductionModel",
        "formalProbabilityInterval"
      ],
      "properties": {
        "version": { "const": "uncertainty-feature-evaluation/1.0.0" },
        "partition": { "const": "development" },
        "foldUnit": { "const": "repository" },
        "targetMetric": { "const": "absolute-reviewed-expected-residual" },
        "normalization": { "const": "candidate-expected-with-0.5-hour-floor" },
        "normalizationFloorHours": { "const": 0.5 },
        "intendedCoverageTarget": { "const": 0.8 },
        "quantileMethod": { "const": "nearest-rank" },
        "minimumBucketObservationCount": { "const": 3 },
        "minimumBucketRepositoryCount": { "const": 2 },
        "repositoryIsolated": { "const": true },
        "developmentOnly": { "const": true },
        "fitsProductionModel": { "const": false },
        "formalProbabilityInterval": { "const": false }
      },
      "additionalProperties": false
    },
    "performance": {
      "type": "object",
      "required": [
        "observationCount",
        "reviewedExpectedCoveredCount",
        "meanWidthHours",
        "meanNormalizedWidth",
        "meanAbsoluteResidualHours",
        "meanIntervalMissHours"
      ],
      "properties": {
        "observationCount": { "type": "integer", "minimum": 0 },
        "reviewedExpectedCoveredCount": { "type": "integer", "minimum": 0 },
        "reviewedExpectedCoverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "meanWidthHours": { "type": "number", "minimum": 0 },
        "meanNormalizedWidth": { "type": "number", "minimum": 0 },
        "meanAbsoluteResidualHours": { "type": "number", "minimum": 0 },
        "meanIntervalMissHours": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "availability": {
      "type": "object",
      "required": [
        "observationCount",
        "availableCount",
        "notApplicableCount",
        "unavailableCount",
        "availableRepositoryCount"
      ],
      "properties": {
        "observationCount": { "type": "integer", "minimum": 0 },
        "availableCount": { "type": "integer", "minimum": 0 },
        "notApplicableCount": { "type": "integer", "minimum": 0 },
        "unavailableCount": { "type": "integer", "minimum": 0 },
        "availableRepositoryCount": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "bucket": {
      "type": "object",
      "required": [
        "id",
        "order",
        "observationCount",
        "repositoryCount",
        "minimumValue",
        "maximumValue",
        "meanValue",
        "meanNormalizedAbsoluteResidual",
        "empirical80thPercentileNormalizedResidual",
        "currentIntervals"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 0 },
        "observationCount": { "type": "integer", "minimum": 1 },
        "repositoryCount": { "type": "integer", "minimum": 1 },
        "minimumValue": { "type": "number", "minimum": 0 },
        "maximumValue": { "type": "number", "minimum": 0 },
        "meanValue": { "type": "number", "minimum": 0 },
        "meanNormalizedAbsoluteResidual": { "type": "number", "minimum": 0 },
        "empirical80thPercentileNormalizedResidual": { "type": "number", "minimum": 0 },
        "currentIntervals": { "$ref": "#/$defs/performance" }
      },
      "additionalProperties": false
    },
    "correlation": { "type": "number", "minimum": -1, "maximum": 1 },
    "feature": {
      "type": "object",
      "required": [
        "featureId",
        "valueKind",
        "monotonicity",
        "widthDriver",
        "availability",
        "crossValidatedIntervals",
        "meanNormalizedWidthDeltaFromBaseline",
        "meanIntervalMissDeltaFromBaseline",
        "conditionedPredictionCount",
        "baselineFallbackCount",
        "monotonicBucketViolationCount",
        "buckets",
        "repositoryFolds"
      ],
      "properties": {
        "featureId": { "type": "string", "minLength": 1 },
        "valueKind": { "enum": ["count", "ratio", "rate", "ordinal"] },
        "monotonicity": {
          "enum": [
            "diagnostic-only",
            "higher-must-not-narrow",
            "lower-must-not-narrow",
            "higher-must-widen"
          ]
        },
        "widthDriver": { "type": "boolean" },
        "availability": { "$ref": "#/$defs/availability" },
        "expectedHoursSpearman": { "$ref": "#/$defs/correlation" },
        "absoluteResidualSpearman": { "$ref": "#/$defs/correlation" },
        "normalizedAbsoluteResidualSpearman": { "$ref": "#/$defs/correlation" },
        "crossValidatedIntervals": { "$ref": "#/$defs/performance" },
        "coverageDeltaFromBaseline": { "type": "number", "minimum": -1, "maximum": 1 },
        "meanNormalizedWidthDeltaFromBaseline": { "type": "number" },
        "meanIntervalMissDeltaFromBaseline": { "type": "number" },
        "conditionedPredictionCount": { "type": "integer", "minimum": 0 },
        "baselineFallbackCount": { "type": "integer", "minimum": 0 },
        "monotonicBucketViolationCount": { "type": "integer", "minimum": 0 },
        "buckets": {
          "type": "array",
          "items": { "$ref": "#/$defs/bucket" }
        },
        "repositoryFolds": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/featureRepositoryFold" }
        }
      },
      "additionalProperties": false
    },
    "featureRepositoryFold": {
      "type": "object",
      "required": [
        "recordId",
        "repositoryId",
        "conditionedPredictionCount",
        "baselineFallbackCount",
        "intervals"
      ],
      "properties": {
        "recordId": { "type": "string", "minLength": 1 },
        "repositoryId": { "type": "string", "minLength": 1 },
        "conditionedPredictionCount": { "type": "integer", "minimum": 0 },
        "baselineFallbackCount": { "type": "integer", "minimum": 0 },
        "intervals": { "$ref": "#/$defs/performance" }
      },
      "additionalProperties": false
    },
    "slice": {
      "type": "object",
      "required": [
        "dimension",
        "value",
        "observationCount",
        "repositoryCount",
        "currentIntervals",
        "crossValidatedBaseline"
      ],
      "properties": {
        "dimension": { "enum": ["category", "ecosystem", "expected-size-band"] },
        "value": { "type": "string", "minLength": 1 },
        "observationCount": { "type": "integer", "minimum": 1 },
        "repositoryCount": { "type": "integer", "minimum": 1 },
        "currentIntervals": { "$ref": "#/$defs/performance" },
        "crossValidatedBaseline": { "$ref": "#/$defs/performance" }
      },
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "required": [
        "recordId",
        "repositoryId",
        "sourceDigest",
        "featureReportDigest",
        "estimateDigest",
        "targetCount",
        "matchedTargetCount",
        "sourceWorkItemReferenceCount",
        "matchedSourceWorkItemReferenceCount",
        "currentIntervals",
        "crossValidatedBaseline",
        "unmatchedTargetIds",
        "categoryMismatchTargetIds"
      ],
      "properties": {
        "recordId": { "type": "string", "minLength": 1 },
        "repositoryId": { "type": "string", "minLength": 1 },
        "sourceDigest": { "$ref": "#/$defs/digest" },
        "featureReportDigest": { "$ref": "#/$defs/digest" },
        "estimateDigest": { "$ref": "#/$defs/digest" },
        "targetCount": { "type": "integer", "minimum": 0 },
        "matchedTargetCount": { "type": "integer", "minimum": 0 },
        "sourceWorkItemReferenceCount": { "type": "integer", "minimum": 0 },
        "matchedSourceWorkItemReferenceCount": { "type": "integer", "minimum": 0 },
        "currentIntervals": { "$ref": "#/$defs/performance" },
        "crossValidatedBaseline": { "$ref": "#/$defs/performance" },
        "unmatchedTargetIds": { "$ref": "#/$defs/stringList" },
        "categoryMismatchTargetIds": { "$ref": "#/$defs/stringList" }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": [
        "recordId",
        "repositoryId",
        "targetId",
        "category",
        "ecosystems",
        "expectedSizeBand",
        "candidateRange",
        "reviewedRange",
        "absoluteExpectedResidualHours",
        "normalizedAbsoluteResidual",
        "currentReviewedExpectedCovered",
        "crossValidatedBaselineRange",
        "baselineReviewedExpectedCovered"
      ],
      "properties": {
        "recordId": { "type": "string", "minLength": 1 },
        "repositoryId": { "type": "string", "minLength": 1 },
        "targetId": { "type": "string", "minLength": 1 },
        "category": { "$ref": "urn:eh:schema:v1:estimate-report#/$defs/category" },
        "ecosystems": { "$ref": "#/$defs/stringList" },
        "expectedSizeBand": { "enum": ["zero", "xs", "s", "m", "l", "xl", "2xl", "3xl", "4xl"] },
        "candidateRange": { "$ref": "urn:eh:schema:v1:estimate-report#/$defs/effortRange" },
        "reviewedRange": { "$ref": "urn:eh:schema:v1:estimate-report#/$defs/effortRange" },
        "absoluteExpectedResidualHours": { "type": "number", "minimum": 0 },
        "normalizedAbsoluteResidual": { "type": "number", "minimum": 0 },
        "currentReviewedExpectedCovered": { "type": "boolean" },
        "crossValidatedBaselineRange": { "$ref": "urn:eh:schema:v1:estimate-report#/$defs/effortRange" },
        "baselineReviewedExpectedCovered": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "recordCount",
        "repositoryCount",
        "featureReportCount",
        "ignoredFeatureReportCount",
        "targetCount",
        "matchedTargetCount",
        "sourceWorkItemReferenceCount",
        "matchedSourceWorkItemReferenceCount"
      ],
      "properties": {
        "recordCount": { "type": "integer", "minimum": 3 },
        "repositoryCount": { "type": "integer", "minimum": 3 },
        "featureReportCount": { "type": "integer", "minimum": 1 },
        "ignoredFeatureReportCount": { "type": "integer", "minimum": 0 },
        "targetCount": { "type": "integer", "minimum": 1 },
        "matchedTargetCount": { "type": "integer", "minimum": 1 },
        "sourceWorkItemReferenceCount": { "type": "integer", "minimum": 1 },
        "matchedSourceWorkItemReferenceCount": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  }
}
