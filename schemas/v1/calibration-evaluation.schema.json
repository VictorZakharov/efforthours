{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fairbill:schema:v1:calibration-evaluation",
  "title": "Fairbill calibration evaluation report v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "evaluatorVersion",
    "metricVersion",
    "corpusId",
    "corpusVersion",
    "partition",
    "recordCount",
    "repositoryCount",
    "ignoredCandidateCount",
    "candidateEstimatorVersions",
    "repositoryTotals",
    "categories",
    "workItems",
    "match",
    "repositories"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "evaluatorVersion": {
      "type": "string",
      "minLength": 1
    },
    "metricVersion": {
      "const": "calibration-metrics/1.0.0"
    },
    "corpusId": {
      "type": "string",
      "minLength": 1
    },
    "corpusVersion": {
      "type": "string",
      "minLength": 1
    },
    "partition": {
      "$ref": "#/$defs/partition"
    },
    "recordCount": {
      "type": "integer",
      "minimum": 1
    },
    "repositoryCount": {
      "type": "integer",
      "minimum": 1
    },
    "ignoredCandidateCount": {
      "type": "integer",
      "minimum": 0
    },
    "candidateEstimatorVersions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "repositoryTotals": {
      "$ref": "#/$defs/rangeMetrics"
    },
    "categories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/categoryMetrics"
      }
    },
    "workItems": {
      "$ref": "#/$defs/rangeMetrics"
    },
    "match": {
      "$ref": "#/$defs/match"
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/repositoryEvaluation"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "pointMetrics": {
      "type": "object",
      "required": [
        "sampleCount",
        "reviewedHours",
        "candidateHours",
        "meanAbsoluteErrorHours",
        "medianAbsoluteErrorHours",
        "rootMeanSquaredErrorHours",
        "meanSignedErrorHours"
      ],
      "properties": {
        "sampleCount": {
          "type": "integer",
          "minimum": 0
        },
        "reviewedHours": {
          "type": "number",
          "minimum": 0
        },
        "candidateHours": {
          "type": "number",
          "minimum": 0
        },
        "meanAbsoluteErrorHours": {
          "type": "number",
          "minimum": 0
        },
        "medianAbsoluteErrorHours": {
          "type": "number",
          "minimum": 0
        },
        "rootMeanSquaredErrorHours": {
          "type": "number",
          "minimum": 0
        },
        "meanSignedErrorHours": {
          "type": "number"
        },
        "weightedAbsolutePercentageError": {
          "type": "number",
          "minimum": 0
        },
        "aggregateBiasRate": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "intervalMetrics": {
      "type": "object",
      "required": [
        "sampleCount",
        "reviewedExpectedCoveredCount",
        "reviewedRangeFullyCoveredCount",
        "meanCandidateWidthHours",
        "meanReviewedWidthHours"
      ],
      "properties": {
        "sampleCount": {
          "type": "integer",
          "minimum": 0
        },
        "reviewedExpectedCoveredCount": {
          "type": "integer",
          "minimum": 0
        },
        "reviewedExpectedCoverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reviewedRangeFullyCoveredCount": {
          "type": "integer",
          "minimum": 0
        },
        "reviewedRangeFullyCoveredRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "meanCandidateWidthHours": {
          "type": "number",
          "minimum": 0
        },
        "meanReviewedWidthHours": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "rangeMetrics": {
      "type": "object",
      "required": [
        "low",
        "expected",
        "high",
        "interval"
      ],
      "properties": {
        "low": {
          "$ref": "#/$defs/pointMetrics"
        },
        "expected": {
          "$ref": "#/$defs/pointMetrics"
        },
        "high": {
          "$ref": "#/$defs/pointMetrics"
        },
        "interval": {
          "$ref": "#/$defs/intervalMetrics"
        }
      },
      "additionalProperties": false
    },
    "categoryMetrics": {
      "type": "object",
      "required": [
        "category",
        "metrics"
      ],
      "properties": {
        "category": {
          "$ref": "#/$defs/category"
        },
        "metrics": {
          "$ref": "#/$defs/rangeMetrics"
        }
      },
      "additionalProperties": false
    },
    "match": {
      "type": "object",
      "required": [
        "targetCount",
        "matchedTargetCount",
        "sourceWorkItemReferenceCount",
        "matchedSourceWorkItemReferenceCount",
        "candidateWorkItemCount",
        "matchedCandidateWorkItemCount"
      ],
      "properties": {
        "targetCount": {
          "type": "integer",
          "minimum": 0
        },
        "matchedTargetCount": {
          "type": "integer",
          "minimum": 0
        },
        "targetMatchRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sourceWorkItemReferenceCount": {
          "type": "integer",
          "minimum": 0
        },
        "matchedSourceWorkItemReferenceCount": {
          "type": "integer",
          "minimum": 0
        },
        "sourceWorkItemReferenceMatchRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "candidateWorkItemCount": {
          "type": "integer",
          "minimum": 0
        },
        "matchedCandidateWorkItemCount": {
          "type": "integer",
          "minimum": 0
        },
        "candidateWorkItemMatchRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "repositoryEvaluation": {
      "type": "object",
      "required": [
        "recordId",
        "repositoryId",
        "sourceDigest",
        "profile",
        "baselineId",
        "candidateEstimatorVersion",
        "candidateEstimateDigest",
        "reviewedTotal",
        "candidateTotal",
        "expectedAbsoluteErrorHours",
        "expectedSignedErrorHours",
        "reviewedExpectedCovered",
        "reviewedRangeFullyCovered",
        "targetCount",
        "matchedTargetCount",
        "candidateWorkItemCount",
        "matchedCandidateWorkItemCount",
        "unmatchedTargetIds",
        "unmatchedCandidateWorkItemIds",
        "categoryMismatchTargetIds"
      ],
      "properties": {
        "recordId": {
          "type": "string",
          "minLength": 1
        },
        "repositoryId": {
          "type": "string",
          "minLength": 1
        },
        "sourceDigest": {
          "type": "string",
          "pattern": "^sha256:.+"
        },
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "baselineId": {
          "type": "string",
          "minLength": 1
        },
        "candidateEstimatorVersion": {
          "type": "string",
          "minLength": 1
        },
        "candidateEstimateDigest": {
          "type": "string",
          "pattern": "^sha256:.+"
        },
        "reviewedTotal": {
          "$ref": "#/$defs/effortRange"
        },
        "candidateTotal": {
          "$ref": "#/$defs/effortRange"
        },
        "expectedAbsoluteErrorHours": {
          "type": "number",
          "minimum": 0
        },
        "expectedSignedErrorHours": {
          "type": "number"
        },
        "reviewedExpectedCovered": {
          "type": "boolean"
        },
        "reviewedRangeFullyCovered": {
          "type": "boolean"
        },
        "targetCount": {
          "type": "integer",
          "minimum": 0
        },
        "matchedTargetCount": {
          "type": "integer",
          "minimum": 0
        },
        "candidateWorkItemCount": {
          "type": "integer",
          "minimum": 0
        },
        "matchedCandidateWorkItemCount": {
          "type": "integer",
          "minimum": 0
        },
        "unmatchedTargetIds": {
          "$ref": "#/$defs/idList"
        },
        "unmatchedCandidateWorkItemIds": {
          "$ref": "#/$defs/idList"
        },
        "categoryMismatchTargetIds": {
          "$ref": "#/$defs/idList"
        }
      },
      "additionalProperties": false
    },
    "effortRange": {
      "type": "object",
      "required": [
        "low",
        "expected",
        "high"
      ],
      "properties": {
        "low": {
          "type": "number",
          "minimum": 0
        },
        "expected": {
          "type": "number",
          "minimum": 0
        },
        "high": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "idList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "partition": {
      "enum": [
        "development",
        "validation",
        "test"
      ]
    },
    "profile": {
      "enum": [
        "implementation",
        "recreation"
      ]
    },
    "category": {
      "enum": [
        "specification-comprehension-and-domain-learning",
        "repository-and-solution-setup",
        "architecture-and-technical-design",
        "production-implementation",
        "ui-implementation-and-represented-ux-decisions",
        "data-modeling-persistence-and-migrations",
        "external-integrations-and-protocols",
        "unit-testing",
        "integration-contract-and-component-testing",
        "end-to-end-and-ui-testing",
        "manual-validation-debugging-and-hardening",
        "documentation",
        "build-configuration-and-developer-tooling",
        "ci-cd-and-infrastructure-as-code",
        "security-and-accessibility",
        "packaging-deployment-and-release-artifacts",
        "self-review-and-system-integration"
      ]
    }
  }
}
