{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eh:schema:v1:snapshot-dashboard-studies",
  "title": "snapshot-dashboard-studies",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projects"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "publicRepositoryUrl",
          "areasDigest",
          "areas"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]{0,79}$"
          },
          "publicRepositoryUrl": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "areasDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "areas": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "folder",
                "reviewedCommit"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9.-]{0,79}$"
                },
                "folder": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "reviewedCommit": {
                  "type": "string",
                  "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
                }
              }
            },
            "minItems": 1,
            "maxItems": 256
          }
        }
      },
      "minItems": 1,
      "maxItems": 256
    }
  }
}
