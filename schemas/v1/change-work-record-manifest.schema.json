{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eh:schema:v1:change-work-record-manifest",
  "title": "External work records v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "sourceSemanticDigest",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "sourceSemanticDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "required": [
          "recordId",
          "date",
          "kind"
        ],
        "properties": {
          "recordId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "format": "date"
          },
          "kind": {
            "enum": [
              "implementation",
              "meeting",
              "pto",
              "mixed"
            ]
          },
          "repositoryIds": {
            "type": "array",
            "minItems": 0,
            "maxItems": 256,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            }
          },
          "loggedHours": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 24
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
