{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fairbill:schema:v1:work-item",
  "title": "Fairbill work item v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "category",
    "title",
    "scope",
    "evidenceIds",
    "quantity",
    "complexity",
    "hours",
    "confidence",
    "reason",
    "estimator",
    "profiles",
    "dependencyIds",
    "assumptions",
    "exclusions",
    "uncertaintyReasons"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "$ref": "#/$defs/category"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "quantity": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "complexity": {
      "enum": [
        "routine",
        "moderate",
        "high",
        "exceptional"
      ]
    },
    "hours": {
      "$ref": "#/$defs/effortRange"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "estimator": {
      "$ref": "#/$defs/estimator"
    },
    "profiles": {
      "type": "array",
      "items": {
        "enum": [
          "implementation",
          "recreation"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "parentId": {
      "type": "string",
      "minLength": 1
    },
    "dependencyIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "correlationGroup": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "$ref": "#/$defs/stringList"
    },
    "exclusions": {
      "$ref": "#/$defs/stringList"
    },
    "uncertaintyReasons": {
      "$ref": "#/$defs/stringList"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "category": {
      "enum": [
        "specification-comprehension-and-domain-learning",
        "repository-and-solution-setup",
        "architecture-and-technical-design",
        "production-implementation",
        "ui-implementation-and-represented-ux-decisions",
        "data-modeling-persistence-and-migrations",
        "external-integrations-and-protocols",
        "unit-testing",
        "integration-contract-and-component-testing",
        "end-to-end-and-ui-testing",
        "manual-validation-debugging-and-hardening",
        "documentation",
        "build-configuration-and-developer-tooling",
        "ci-cd-and-infrastructure-as-code",
        "security-and-accessibility",
        "packaging-deployment-and-release-artifacts",
        "self-review-and-system-integration"
      ]
    },
    "effortRange": {
      "type": "object",
      "required": [
        "low",
        "expected",
        "high"
      ],
      "properties": {
        "low": {
          "type": "number",
          "minimum": 0
        },
        "expected": {
          "type": "number",
          "minimum": 0
        },
        "high": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "estimator": {
      "type": "object",
      "required": [
        "id",
        "version",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "rule",
            "local-ml",
            "host-ai",
            "human"
          ]
        }
      },
      "additionalProperties": false
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
