{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eh:schema:v1:calibration-diagnostic",
  "title": "EffortHours calibration residual diagnostic report v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "diagnosticVersion",
    "corpusId",
    "corpusVersion",
    "partition",
    "recordCount",
    "repositoryCount",
    "ignoredCandidateCount",
    "candidateEstimatorVersions",
    "materialContributionThreshold",
    "summary",
    "repositories"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "diagnosticVersion": {
      "const": "calibration-residual-diagnostic/1.0.0"
    },
    "corpusId": {
      "type": "string",
      "minLength": 1
    },
    "corpusVersion": {
      "type": "string",
      "minLength": 1
    },
    "partition": {
      "$ref": "#/$defs/partition"
    },
    "recordCount": {
      "type": "integer",
      "minimum": 1
    },
    "repositoryCount": {
      "type": "integer",
      "minimum": 1
    },
    "ignoredCandidateCount": {
      "type": "integer",
      "minimum": 0
    },
    "candidateEstimatorVersions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "materialContributionThreshold": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/repository"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "summary": {
      "type": "object",
      "required": [
        "range",
        "grossRepositoryExpectedErrorHours",
        "repositoryCancellationHours",
        "grossCategoryExpectedErrorHours",
        "grossComponentExpectedErrorHours",
        "componentCount",
        "materialComponentCount",
        "reviewedSizeExceptionTargetCount",
        "oversizedReviewedTargetCount",
        "reviewedExpectedCoveredRepositoryCount",
        "candidateTooHighRepositoryCount",
        "candidateTooLowRepositoryCount",
        "candidateSymmetricRepositoryCount",
        "rawRepositoryWidthCorrelationSampleCount",
        "normalizedRepositoryWidthCorrelationSampleCount",
        "repositoryReconciliationDelta"
      ],
      "properties": {
        "range": {
          "$ref": "#/$defs/rangeDiagnostic"
        },
        "grossRepositoryExpectedErrorHours": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "repositoryCancellationHours": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "grossCategoryExpectedErrorHours": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "grossComponentExpectedErrorHours": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "componentCount": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "materialComponentCount": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "reviewedSizeExceptionTargetCount": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "oversizedReviewedTargetCount": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "reviewedExpectedCoveredRepositoryCount": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "candidateTooHighRepositoryCount": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "candidateTooLowRepositoryCount": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "candidateSymmetricRepositoryCount": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "rawRepositoryWidthCorrelationSampleCount": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "rawRepositoryWidthCorrelation": {
          "$ref": "#/$defs/correlation"
        },
        "normalizedRepositoryWidthCorrelationSampleCount": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "normalizedRepositoryWidthCorrelation": {
          "$ref": "#/$defs/correlation"
        },
        "repositoryReconciliationDelta": {
          "$ref": "#/$defs/signedRange"
        }
      },
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "required": [
        "rank",
        "recordId",
        "repositoryId",
        "sourceDigest",
        "profile",
        "baselineId",
        "candidateEstimatorVersion",
        "candidateEstimateDigest",
        "range",
        "targetCount",
        "candidateWorkItemCount",
        "matchedTargetCount",
        "incompleteTargetCount",
        "categoryMismatchTargetCount",
        "unmatchedCandidateWorkItemCount",
        "reviewedSizeExceptionTargetCount",
        "oversizedReviewedTargetCount",
        "grossCategoryExpectedErrorHours",
        "categoryCancellationHours",
        "grossComponentExpectedErrorHours",
        "componentCancellationHours",
        "materialCategoryCount",
        "materialComponentCount",
        "categoryReconciliationDelta",
        "componentReconciliationDelta",
        "categories",
        "components"
      ],
      "properties": {
        "rank": {
          "$ref": "#/$defs/positiveInteger"
        },
        "recordId": {
          "$ref": "#/$defs/nonemptyString"
        },
        "repositoryId": {
          "$ref": "#/$defs/nonemptyString"
        },
        "sourceDigest": {
          "$ref": "#/$defs/digest"
        },
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "baselineId": {
          "$ref": "#/$defs/nonemptyString"
        },
        "candidateEstimatorVersion": {
          "$ref": "#/$defs/nonemptyString"
        },
        "candidateEstimateDigest": {
          "$ref": "#/$defs/digest"
        },
        "range": {
          "$ref": "#/$defs/rangeDiagnostic"
        },
        "targetCount": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "candidateWorkItemCount": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "matchedTargetCount": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "incompleteTargetCount": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "categoryMismatchTargetCount": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "unmatchedCandidateWorkItemCount": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "reviewedSizeExceptionTargetCount": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "oversizedReviewedTargetCount": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "grossCategoryExpectedErrorHours": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "categoryCancellationHours": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "grossComponentExpectedErrorHours": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "componentCancellationHours": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "materialCategoryCount": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "materialComponentCount": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "categoryReconciliationDelta": {
          "$ref": "#/$defs/signedRange"
        },
        "componentReconciliationDelta": {
          "$ref": "#/$defs/signedRange"
        },
        "categories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/categoryResidual"
          }
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        }
      },
      "additionalProperties": false
    },
    "categoryResidual": {
      "type": "object",
      "required": [
        "rank",
        "category",
        "range",
        "absoluteErrorShare",
        "cumulativeAbsoluteErrorShare",
        "materialContributor"
      ],
      "properties": {
        "rank": {
          "$ref": "#/$defs/positiveInteger"
        },
        "category": {
          "$ref": "#/$defs/category"
        },
        "range": {
          "$ref": "#/$defs/rangeDiagnostic"
        },
        "absoluteErrorShare": {
          "$ref": "#/$defs/unitRatio"
        },
        "cumulativeAbsoluteErrorShare": {
          "$ref": "#/$defs/unitRatio"
        },
        "materialContributor": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": [
        "rank",
        "kind",
        "mappingStatus",
        "id",
        "category",
        "title",
        "scope",
        "candidateLeafCount",
        "candidateLeaves",
        "missingCandidateWorkItemIds",
        "reviewedEvidenceIds",
        "candidateEvidenceIds",
        "candidateReasons",
        "range",
        "reviewedUncertaintyReasons",
        "candidateUncertaintyReasons",
        "absoluteErrorShare",
        "cumulativeAbsoluteErrorShare",
        "materialContributor"
      ],
      "properties": {
        "rank": {
          "$ref": "#/$defs/positiveInteger"
        },
        "kind": {
          "enum": [
            "reviewed-target",
            "unmatched-candidate-work-item"
          ]
        },
        "mappingStatus": {
          "enum": [
            "matched",
            "incomplete",
            "category-mismatch",
            "unmatched-candidate"
          ]
        },
        "id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "reviewedTargetId": {
          "$ref": "#/$defs/nonemptyString"
        },
        "category": {
          "$ref": "#/$defs/category"
        },
        "title": {
          "$ref": "#/$defs/nonemptyString"
        },
        "scope": {
          "$ref": "#/$defs/nonemptyString"
        },
        "reviewedRationale": {
          "$ref": "#/$defs/nonemptyString"
        },
        "reviewedSizeException": {
          "$ref": "#/$defs/nonemptyString"
        },
        "candidateLeafCount": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "candidateLeaves": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidateLeaf"
          }
        },
        "missingCandidateWorkItemIds": {
          "$ref": "#/$defs/idList"
        },
        "reviewedEvidenceIds": {
          "$ref": "#/$defs/idList"
        },
        "candidateEvidenceIds": {
          "$ref": "#/$defs/idList"
        },
        "candidateReasons": {
          "$ref": "#/$defs/idList"
        },
        "range": {
          "$ref": "#/$defs/rangeDiagnostic"
        },
        "candidateConfidence": {
          "$ref": "#/$defs/unitRatio"
        },
        "reviewedUncertaintyReasons": {
          "$ref": "#/$defs/idList"
        },
        "candidateUncertaintyReasons": {
          "$ref": "#/$defs/idList"
        },
        "absoluteErrorShare": {
          "$ref": "#/$defs/unitRatio"
        },
        "cumulativeAbsoluteErrorShare": {
          "$ref": "#/$defs/unitRatio"
        },
        "materialContributor": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "candidateLeaf": {
      "type": "object",
      "required": [
        "id",
        "category",
        "title",
        "scope",
        "complexity",
        "hours",
        "confidence",
        "evidenceCount",
        "evidenceDigest",
        "reasonIndex",
        "assumptionCount",
        "exclusionCount",
        "uncertaintyReasonCount"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "category": {
          "$ref": "#/$defs/category"
        },
        "title": {
          "$ref": "#/$defs/nonemptyString"
        },
        "scope": {
          "$ref": "#/$defs/nonemptyString"
        },
        "complexity": {
          "enum": [
            "routine",
            "moderate",
            "high",
            "exceptional"
          ]
        },
        "hours": {
          "$ref": "#/$defs/effortRange"
        },
        "confidence": {
          "$ref": "#/$defs/unitRatio"
        },
        "evidenceCount": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "evidenceDigest": {
          "$ref": "#/$defs/digest"
        },
        "reasonIndex": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "assumptionCount": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "exclusionCount": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "uncertaintyReasonCount": {
          "$ref": "#/$defs/nonnegativeInteger"
        }
      },
      "additionalProperties": false
    },
    "rangeDiagnostic": {
      "type": "object",
      "required": [
        "reviewed",
        "candidate",
        "signedError",
        "expectedAbsoluteErrorHours",
        "reviewedExpectedStatus",
        "intervalMissHours",
        "candidateWidthHours",
        "reviewedWidthHours",
        "candidateLowerDistanceHours",
        "candidateUpperDistanceHours",
        "candidateAbsoluteAsymmetryHours",
        "candidateRelativeAsymmetry",
        "candidateSymmetric"
      ],
      "properties": {
        "reviewed": {
          "$ref": "#/$defs/effortRange"
        },
        "candidate": {
          "$ref": "#/$defs/effortRange"
        },
        "signedError": {
          "$ref": "#/$defs/signedRange"
        },
        "expectedAbsoluteErrorHours": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "reviewedExpectedStatus": {
          "enum": [
            "covered",
            "candidate-too-high",
            "candidate-too-low"
          ]
        },
        "intervalMissHours": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "candidateWidthHours": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "reviewedWidthHours": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "candidateLowerDistanceHours": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "candidateUpperDistanceHours": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "candidateAbsoluteAsymmetryHours": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "candidateRelativeAsymmetry": {
          "$ref": "#/$defs/unitRatio"
        },
        "candidateSymmetric": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "effortRange": {
      "type": "object",
      "required": [
        "low",
        "expected",
        "high"
      ],
      "properties": {
        "low": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "expected": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "high": {
          "$ref": "#/$defs/nonnegativeNumber"
        }
      },
      "additionalProperties": false
    },
    "signedRange": {
      "type": "object",
      "description": "Candidate minus reviewed hours at each range point.",
      "required": [
        "low",
        "expected",
        "high"
      ],
      "properties": {
        "low": {
          "type": "number"
        },
        "expected": {
          "type": "number"
        },
        "high": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "partition": {
      "enum": [
        "development",
        "validation",
        "test"
      ]
    },
    "profile": {
      "enum": [
        "implementation",
        "recreation"
      ]
    },
    "category": {
      "enum": [
        "specification-comprehension-and-domain-learning",
        "repository-and-solution-setup",
        "architecture-and-technical-design",
        "production-implementation",
        "ui-implementation-and-represented-ux-decisions",
        "data-modeling-persistence-and-migrations",
        "external-integrations-and-protocols",
        "unit-testing",
        "integration-contract-and-component-testing",
        "end-to-end-and-ui-testing",
        "manual-validation-debugging-and-hardening",
        "documentation",
        "build-configuration-and-developer-tooling",
        "ci-cd-and-infrastructure-as-code",
        "security-and-accessibility",
        "packaging-deployment-and-release-artifacts",
        "self-review-and-system-integration"
      ]
    },
    "idList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonemptyString"
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:.+"
    },
    "nonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "nonnegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "nonnegativeNumber": {
      "type": "number",
      "minimum": 0
    },
    "unitRatio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "correlation": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    }
  }
}
