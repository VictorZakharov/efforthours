{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fairbill:schema:v1:diagnostic",
  "title": "Fairbill diagnostic v1",
  "type": "object",
  "required": [
    "code",
    "severity",
    "message",
    "evidenceIds",
    "locations"
  ],
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "enum": [
        "information",
        "warning",
        "error"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "locations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/location"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "location": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
