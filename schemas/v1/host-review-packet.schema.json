{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eh:schema:v1:host-review-packet",
  "title": "EffortHours host-review packet v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "protocolVersion",
    "inputDigest",
    "estimatorVersion",
    "repository",
    "profile",
    "baseline",
    "totalEffort",
    "categories",
    "estimators",
    "candidates",
    "evidenceFacts",
    "missingEvidenceIds",
    "omissions",
    "reviewerModel",
    "availableQueries",
    "structuralLimits",
    "diagnostics",
    "assumptions",
    "verification",
    "reviewObjective",
    "localBaselineComplete",
    "pricingIncluded",
    "callerResponsibilities",
    "statusDisclaimer"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "protocolVersion": { "const": "host-review/1.0.0" },
    "inputDigest": { "$ref": "#/$defs/digest" },
    "estimatorVersion": { "type": "string", "minLength": 1 },
    "repository": { "$ref": "urn:eh:schema:v1:estimate-report#/$defs/repository" },
    "profile": {
      "enum": ["implementation", "recreation"]
    },
    "baseline": { "$ref": "urn:eh:schema:v1:estimate-report#/$defs/baseline" },
    "totalEffort": { "$ref": "urn:eh:schema:v1:estimate-report#/$defs/effortRange" },
    "categories": {
      "type": "array",
      "items": { "$ref": "urn:eh:schema:v1:estimate-view#/$defs/categoryEntry" }
    },
    "estimators": {
      "type": "array",
      "items": { "$ref": "urn:eh:schema:v1:estimate-explanation#/$defs/estimator" },
      "uniqueItems": true
    },
    "candidates": {
      "type": "array",
      "maxItems": 12,
      "items": { "$ref": "#/$defs/candidate" }
    },
    "evidenceFacts": {
      "type": "array",
      "maxItems": 48,
      "items": { "$ref": "urn:eh:schema:v1:repository-evidence#/$defs/fact" }
    },
    "missingEvidenceIds": { "$ref": "#/$defs/uniqueStrings" },
    "omissions": { "$ref": "#/$defs/omissions" },
    "reviewerModel": { "$ref": "#/$defs/modelIdentity" },
    "availableQueries": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": ["capability", "evidence", "scope", "selected-source"]
      }
    },
    "structuralLimits": { "$ref": "#/$defs/structuralLimits" },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "urn:eh:schema:v1:diagnostic" }
    },
    "assumptions": { "$ref": "#/$defs/uniqueStrings" },
    "verification": { "$ref": "urn:eh:schema:v1:estimate-report#/$defs/verification" },
    "reviewObjective": { "type": "string", "minLength": 1 },
    "localBaselineComplete": { "const": true },
    "pricingIncluded": { "const": false },
    "callerResponsibilities": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "statusDisclaimer": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "uniqueStrings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "modelIdentity": {
      "type": "object",
      "required": ["isAvailable"],
      "properties": {
        "isAvailable": { "type": "boolean" },
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": [
        "capability",
        "estimationReasons",
        "evidenceIds",
        "estimators",
        "assumptions",
        "exclusions",
        "correlationGroups",
        "uncertaintyReasons"
      ],
      "properties": {
        "capability": { "$ref": "urn:eh:schema:v1:estimate-view#/$defs/capabilityEntry" },
        "estimationReasons": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "estimators": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "urn:eh:schema:v1:estimate-explanation#/$defs/estimator" },
          "uniqueItems": true
        },
        "assumptions": { "$ref": "#/$defs/uniqueStrings" },
        "exclusions": { "$ref": "#/$defs/uniqueStrings" },
        "correlationGroups": { "$ref": "#/$defs/uniqueStrings" },
        "uncertaintyReasons": { "$ref": "#/$defs/uniqueStrings" }
      },
      "additionalProperties": false
    },
    "omissions": {
      "type": "object",
      "required": [
        "capabilityCount",
        "capabilityExpectedHours",
        "evidenceFactCount",
        "missingEvidenceFactCount"
      ],
      "properties": {
        "capabilityCount": { "type": "integer", "minimum": 0 },
        "capabilityExpectedHours": { "type": "number", "minimum": 0 },
        "evidenceFactCount": { "type": "integer", "minimum": 0 },
        "missingEvidenceFactCount": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "structuralLimits": {
      "type": "object",
      "required": [
        "packetCapabilities",
        "packetEvidenceFacts",
        "queryEvidenceFacts",
        "scopeCapabilities",
        "sourceLines",
        "sourceCharacters",
        "sourceBytes"
      ],
      "properties": {
        "packetCapabilities": { "const": 12 },
        "packetEvidenceFacts": { "const": 48 },
        "queryEvidenceFacts": { "const": 48 },
        "scopeCapabilities": { "const": 20 },
        "sourceLines": { "const": 200 },
        "sourceCharacters": { "const": 65536 },
        "sourceBytes": { "const": 1048576 }
      },
      "additionalProperties": false
    }
  }
}
