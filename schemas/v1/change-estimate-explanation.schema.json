{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eh:schema:v1:change-estimate-explanation",
  "title": "EffortHours change estimate explanation v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "sourceChangeEstimateSchemaVersion",
    "estimatorVersion",
    "selection",
    "requestedId",
    "workItems",
    "evidence",
    "unresolvedEvidenceIds"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "sourceChangeEstimateSchemaVersion": { "const": "1.0.0" },
    "estimatorVersion": { "type": "string", "minLength": 1 },
    "selection": { "$ref": "urn:eh:schema:v1:change-evidence#/$defs/selection" },
    "requestedId": { "type": "string", "minLength": 1 },
    "workItems": {
      "type": "array",
      "items": { "$ref": "urn:eh:schema:v1:work-item" }
    },
    "normalization": {
      "$ref": "urn:eh:schema:v1:change-estimate-report#/$defs/normalization"
    },
    "adjustments": {
      "type": "array",
      "items": { "$ref": "urn:eh:schema:v1:change-estimate-report#/$defs/adjustment" }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "urn:eh:schema:v1:change-evidence#/$defs/pathEvidence" }
    },
    "unresolvedEvidenceIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "oneOf": [
    {
      "properties": { "workItems": { "minItems": 1 } },
      "not": { "required": ["normalization"] }
    },
    {
      "required": ["normalization", "adjustments"],
      "properties": { "workItems": { "maxItems": 0 } }
    }
  ],
  "additionalProperties": false
}
