{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eh:schema:v1:change-historical-refresh-current",
  "title": "EffortHours freshly observed historical refresh snapshots v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceSemanticDigest",
    "workRecordInputDigest",
    "sinceInclusiveDate",
    "untilExclusiveDate",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "sourceSemanticDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "workRecordInputDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "sinceInclusiveDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "untilExclusiveDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "entries": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "recordId",
          "original",
          "notePermission",
          "ehePermission",
          "restriction"
        ],
        "properties": {
          "recordId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "original": {
            "type": "object",
            "required": [
              "description"
            ],
            "properties": {
              "description": {
                "type": "string",
                "maxLength": 8192
              }
            }
          },
          "notePermission": {
            "enum": [
              "allowed",
              "denied",
              "unknown"
            ]
          },
          "ehePermission": {
            "enum": [
              "allowed",
              "denied",
              "unknown"
            ]
          },
          "restriction": {
            "enum": [
              "none",
              "locked",
              "invoiced",
              "unknown"
            ]
          }
        }
      }
    }
  }
}
