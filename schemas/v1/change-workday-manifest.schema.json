{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eh:schema:v1:change-workday-manifest",
  "title": "EffortHours explicit external workday declarations v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "sourceSemanticDigest",
    "workdays"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "sourceSemanticDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "workdays": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "required": [
          "recordId",
          "date"
        ],
        "properties": {
          "recordId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "format": "date"
          },
          "loggedHours": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 24
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
