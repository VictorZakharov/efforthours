{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fairbill:schema:v1:calibration-corpus-review-plan",
  "title": "Fairbill completed calibration-corpus review plan v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "compilerVersion",
    "sourceCorpus",
    "id",
    "version",
    "description",
    "records"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "compilerVersion": { "type": "string", "minLength": 1 },
    "sourceCorpus": { "$ref": "#/$defs/corpusReference" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "corpusReference": {
      "type": "object",
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:.+" }
      },
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "required": [
        "sourceRecordId",
        "resultStatus",
        "completedOn",
        "reviewers",
        "notes",
        "targets"
      ],
      "properties": {
        "sourceRecordId": { "type": "string", "minLength": 1 },
        "resultStatus": { "enum": ["reviewed", "adjudicated"] },
        "completedOn": { "type": "string", "format": "date" },
        "reviewers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/reviewer" }
        },
        "notes": { "type": "string", "minLength": 1 },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/target" }
        }
      },
      "additionalProperties": false
    },
    "reviewer": {
      "type": "object",
      "required": ["id", "kind", "role"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["human", "host-ai"] },
        "role": { "enum": ["reviewer", "adjudicator"] },
        "modelId": { "type": "string", "minLength": 1 },
        "modelVersion": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": [
        "sourceTargetId",
        "action",
        "hours",
        "rationale",
        "uncertaintyReasons",
        "sizeException"
      ],
      "properties": {
        "sourceTargetId": { "type": "string", "minLength": 1 },
        "action": { "enum": ["accept", "replace"] },
        "hours": {
          "oneOf": [
            { "$ref": "#/$defs/effortRange" },
            { "type": "null" }
          ]
        },
        "rationale": { "type": ["string", "null"], "minLength": 1 },
        "uncertaintyReasons": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "sizeException": { "type": ["string", "null"], "minLength": 1 }
      },
      "additionalProperties": false
    },
    "effortRange": {
      "type": "object",
      "required": ["low", "expected", "high"],
      "properties": {
        "low": { "type": "number", "minimum": 0 },
        "expected": { "type": "number", "exclusiveMinimum": 0 },
        "high": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
