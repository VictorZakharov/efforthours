{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eh:schema:v1:calibration-manual-qa-decision-plan",
  "title": "EffortHours manual-QA development decision plan v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "planVersion",
    "compilerVersion",
    "status",
    "id",
    "version",
    "description",
    "policy",
    "sourceCorpus",
    "reviewManifest",
    "reviewRubric",
    "outputCorpus",
    "partition",
    "profile",
    "baselineId",
    "recordCount",
    "decisionCount",
    "records",
    "instructions"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "planVersion": { "type": "string", "minLength": 1 },
    "compilerVersion": { "type": "string", "minLength": 1 },
    "status": { "enum": ["unreviewed", "completed"] },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "policy": { "$ref": "#/$defs/policyReference" },
    "sourceCorpus": { "$ref": "#/$defs/corpusReference" },
    "reviewManifest": { "$ref": "#/$defs/manifestReference" },
    "reviewRubric": { "$ref": "#/$defs/rubric" },
    "outputCorpus": { "$ref": "#/$defs/outputCorpus" },
    "partition": { "const": "development" },
    "profile": { "const": "implementation" },
    "baselineId": { "type": "string", "minLength": 1 },
    "recordCount": { "type": "integer", "minimum": 1 },
    "decisionCount": { "type": "integer", "minimum": 1 },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/record" }
    },
    "instructions": { "$ref": "#/$defs/nonEmptyStrings" }
  },
  "additionalProperties": false,
  "$defs": {
    "policyReference": {
      "type": "object",
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "corpusReference": {
      "type": "object",
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "manifestReference": {
      "type": "object",
      "required": ["version", "digest"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "rubric": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "outputCorpus": {
      "type": "object",
      "required": ["id", "version", "description", "rubric"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "rubric": { "$ref": "#/$defs/rubric" }
      },
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "required": ["sourceRecordId", "packetDigest", "lineageDigest", "review", "decisions"],
      "properties": {
        "sourceRecordId": { "type": "string", "minLength": 1 },
        "packetDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "lineageDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "review": {
          "oneOf": [
            { "$ref": "#/$defs/review" },
            { "type": "null" }
          ]
        },
        "decisions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/decision" }
        }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": ["status", "completedOn", "reviewers"],
      "properties": {
        "status": { "const": "teacher-estimate" },
        "completedOn": { "type": "string", "format": "date" },
        "reviewers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/reviewer" }
        },
        "notes": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "reviewer": {
      "type": "object",
      "required": ["id", "kind", "role"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["human", "host-ai"] },
        "role": { "enum": ["teacher", "reviewer", "adjudicator"] },
        "modelId": { "type": "string", "minLength": 1 },
        "modelVersion": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": [
        "sourceTargetId",
        "sourceLineageDigest",
        "overlapGroupId",
        "disposition",
        "hours",
        "rationale",
        "evidenceIds",
        "uncertaintyReasons",
        "overlapAllocation",
        "duplicateOfSourceTargetId",
        "sizeException"
      ],
      "properties": {
        "sourceTargetId": { "type": "string", "minLength": 1 },
        "sourceLineageDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "overlapGroupId": { "type": "string", "minLength": 1 },
        "disposition": {
          "oneOf": [
            { "enum": ["estimate", "exclude", "duplicate"] },
            { "type": "null" }
          ]
        },
        "hours": {
          "oneOf": [
            { "$ref": "#/$defs/effortRange" },
            { "type": "null" }
          ]
        },
        "rationale": { "type": ["string", "null"], "minLength": 1 },
        "evidenceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "uncertaintyReasons": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "overlapAllocation": { "type": ["string", "null"], "minLength": 1 },
        "duplicateOfSourceTargetId": { "type": ["string", "null"], "minLength": 1 },
        "sizeException": { "type": ["string", "null"], "minLength": 1 }
      },
      "additionalProperties": false
    },
    "effortRange": {
      "type": "object",
      "required": ["low", "expected", "high"],
      "properties": {
        "low": { "type": "number", "minimum": 0 },
        "expected": { "type": "number", "minimum": 0 },
        "high": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
