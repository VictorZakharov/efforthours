{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fairbill:schema:v1:seed-rule-model",
  "title": "Fairbill seed-rule model v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "version",
    "status",
    "description",
    "technologyBaselineYear",
    "itemSizing",
    "complexityFactors",
    "provenanceConfidence",
    "rules"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "experimental-uncalibrated",
        "experimental-calibrated",
        "stable"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "technologyBaselineYear": {
      "type": "integer",
      "minimum": 2026
    },
    "itemSizing": {
      "$ref": "#/$defs/itemSizing"
    },
    "complexityFactors": {
      "$ref": "#/$defs/complexityFactors"
    },
    "provenanceConfidence": {
      "$ref": "#/$defs/provenanceConfidence"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "itemSizing": {
      "type": "object",
      "required": [
        "minimumExpectedHours",
        "targetExpectedHours",
        "maximumExpectedHours",
        "roundingIncrementHours"
      ],
      "properties": {
        "minimumExpectedHours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maximumExpectedHours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "targetExpectedHours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "roundingIncrementHours": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "complexityFactors": {
      "type": "object",
      "required": [
        "routine",
        "moderate",
        "high",
        "exceptional"
      ],
      "properties": {
        "routine": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "moderate": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "high": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "exceptional": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "provenanceConfidence": {
      "type": "object",
      "required": [
        "observed",
        "measured",
        "declaredAssumed",
        "inferred"
      ],
      "properties": {
        "observed": {
          "$ref": "#/$defs/confidence"
        },
        "measured": {
          "$ref": "#/$defs/confidence"
        },
        "declaredAssumed": {
          "$ref": "#/$defs/confidence"
        },
        "inferred": {
          "$ref": "#/$defs/confidence"
        }
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "required": [
        "id",
        "category",
        "quantityUnit",
        "setupHours",
        "lowFactor",
        "highFactor",
        "defaultConfidence",
        "drivers"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "category": {
          "$ref": "#/$defs/category"
        },
        "quantityUnit": {
          "type": "string",
          "minLength": 1
        },
        "setupHours": {
          "type": "number",
          "minimum": 0
        },
        "lowFactor": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "highFactor": {
          "type": "number",
          "minimum": 1
        },
        "defaultConfidence": {
          "$ref": "#/$defs/confidence"
        },
        "drivers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/driver"
          }
        }
      },
      "additionalProperties": false
    },
    "driver": {
      "type": "object",
      "required": [
        "name",
        "tiers"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "tiers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/tier"
          }
        }
      },
      "additionalProperties": false
    },
    "tier": {
      "type": "object",
      "required": [
        "hoursPerUnit"
      ],
      "properties": {
        "upTo": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "hoursPerUnit": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "category": {
      "enum": [
        "specification-comprehension-and-domain-learning",
        "repository-and-solution-setup",
        "architecture-and-technical-design",
        "production-implementation",
        "ui-implementation-and-represented-ux-decisions",
        "data-modeling-persistence-and-migrations",
        "external-integrations-and-protocols",
        "unit-testing",
        "integration-contract-and-component-testing",
        "end-to-end-and-ui-testing",
        "manual-validation-debugging-and-hardening",
        "documentation",
        "build-configuration-and-developer-tooling",
        "ci-cd-and-infrastructure-as-code",
        "security-and-accessibility",
        "packaging-deployment-and-release-artifacts",
        "self-review-and-system-integration"
      ]
    }
  }
}
