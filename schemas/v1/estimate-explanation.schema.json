{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eh:schema:v1:estimate-explanation",
  "title": "EffortHours estimate explanation v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "evidenceSchemaVersion",
    "estimatorVersion",
    "repository",
    "profile",
    "requestedId",
    "matchKind",
    "capability",
    "workItems",
    "evidenceFacts",
    "missingEvidenceIds",
    "estimators",
    "assumptions",
    "exclusions",
    "correlationGroups",
    "uncertaintyReasons",
    "diagnostics",
    "verification"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "evidenceSchemaVersion": {
      "const": "1.0.0"
    },
    "estimatorVersion": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "$ref": "urn:eh:schema:v1:estimate-report#/$defs/repository"
    },
    "profile": {
      "enum": [
        "implementation",
        "recreation"
      ]
    },
    "requestedId": {
      "type": "string",
      "minLength": 1
    },
    "matchKind": {
      "enum": [
        "work-item",
        "capability"
      ]
    },
    "capability": {
      "$ref": "urn:eh:schema:v1:estimate-view#/$defs/capabilityEntry"
    },
    "workItems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:eh:schema:v1:work-item"
      }
    },
    "evidenceFacts": {
      "type": "array",
      "items": {
        "$ref": "urn:eh:schema:v1:repository-evidence#/$defs/fact"
      }
    },
    "missingEvidenceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "estimators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/estimator"
      }
    },
    "assumptions": {
      "$ref": "#/$defs/uniqueStrings"
    },
    "exclusions": {
      "$ref": "#/$defs/uniqueStrings"
    },
    "correlationGroups": {
      "$ref": "#/$defs/uniqueStrings"
    },
    "uncertaintyReasons": {
      "$ref": "#/$defs/uniqueStrings"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "urn:eh:schema:v1:diagnostic"
      }
    },
    "verification": {
      "$ref": "urn:eh:schema:v1:estimate-report#/$defs/verification"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "estimator": {
      "type": "object",
      "required": [
        "id",
        "version",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "rule",
            "local-ml",
            "host-ai",
            "human"
          ]
        }
      },
      "additionalProperties": false
    },
    "uniqueStrings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
