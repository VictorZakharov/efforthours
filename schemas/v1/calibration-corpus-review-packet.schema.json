{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eh:schema:v1:calibration-corpus-review-packet",
  "title": "EffortHours unreviewed calibration-corpus review packet v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "authoringVersion",
    "status",
    "warning",
    "sourceCorpus",
    "rubric",
    "candidateVisibility",
    "records",
    "instructions"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "authoringVersion": { "type": "string", "minLength": 1 },
    "status": { "const": "unreviewed" },
    "warning": { "type": "string", "minLength": 1 },
    "sourceCorpus": { "$ref": "#/$defs/corpusReference" },
    "rubric": { "$ref": "#/$defs/rubric" },
    "candidateVisibility": { "enum": ["reference", "blind"] },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/record" }
    },
    "instructions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "corpusReference": {
      "type": "object",
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:.+" }
      },
      "additionalProperties": false
    },
    "rubric": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "required": [
        "sourceRecordId",
        "repository",
        "profile",
        "baselineId",
        "partition",
        "sourceReviewStatus",
        "candidateTotalHours",
        "targets"
      ],
      "properties": {
        "sourceRecordId": { "type": "string", "minLength": 1 },
        "repository": { "$ref": "#/$defs/repository" },
        "change": { "$ref": "#/$defs/change" },
        "profile": { "$ref": "#/$defs/profile" },
        "baselineId": { "type": "string", "minLength": 1 },
        "partition": { "$ref": "#/$defs/partition" },
        "sourceReviewStatus": { "$ref": "#/$defs/reviewStatus" },
        "candidateTotalHours": {
          "oneOf": [
            { "$ref": "#/$defs/effortRange" },
            { "type": "null" }
          ]
        },
        "targets": {
          "type": "array",
          "items": { "$ref": "#/$defs/target" }
        }
      },
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "required": ["id", "name", "sourceDigest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "sourceDigest": { "type": "string", "pattern": "^sha256:.+" }
      },
      "additionalProperties": false
    },
    "change": {
      "type": "object",
      "required": [
        "id",
        "selectionKind",
        "baseObjectId",
        "headObjectId",
        "baseEvidenceDigest",
        "headEvidenceDigest",
        "finalDeltaDigest",
        "coverageTags"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "selectionKind": { "enum": ["base-head", "commit", "range", "pull-request"] },
        "baseObjectId": { "type": "string", "minLength": 1 },
        "headObjectId": { "type": "string", "minLength": 1 },
        "baseEvidenceDigest": { "type": "string", "pattern": "^sha256:.+" },
        "headEvidenceDigest": { "type": "string", "pattern": "^sha256:.+" },
        "finalDeltaDigest": { "type": "string", "pattern": "^sha256:.+" },
        "coverageTags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": [
        "sourceTargetId",
        "category",
        "title",
        "scope",
        "sourceWorkItemIds",
        "evidenceIds",
        "candidate",
        "review"
      ],
      "properties": {
        "sourceTargetId": { "type": "string", "minLength": 1 },
        "category": { "$ref": "#/$defs/category" },
        "title": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "sourceWorkItemIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "candidate": { "$ref": "#/$defs/candidate" },
        "review": { "$ref": "#/$defs/reviewFields" }
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": ["hours", "rationale", "uncertaintyReasons", "sizeException"],
      "properties": {
        "hours": {
          "oneOf": [
            { "$ref": "#/$defs/effortRange" },
            { "type": "null" }
          ]
        },
        "rationale": { "type": ["string", "null"], "minLength": 1 },
        "uncertaintyReasons": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "sizeException": { "type": ["string", "null"], "minLength": 1 }
      },
      "additionalProperties": false
    },
    "reviewFields": {
      "type": "object",
      "required": ["action", "hours", "rationale", "uncertaintyReasons", "sizeException"],
      "properties": {
        "action": {
          "oneOf": [
            { "enum": ["accept", "replace"] },
            { "type": "null" }
          ]
        },
        "hours": {
          "oneOf": [
            { "$ref": "#/$defs/effortRange" },
            { "type": "null" }
          ]
        },
        "rationale": { "type": ["string", "null"], "minLength": 1 },
        "uncertaintyReasons": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "sizeException": { "type": ["string", "null"], "minLength": 1 }
      },
      "additionalProperties": false
    },
    "effortRange": {
      "type": "object",
      "required": ["low", "expected", "high"],
      "properties": {
        "low": { "type": "number", "minimum": 0 },
        "expected": { "type": "number", "minimum": 0 },
        "high": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "profile": { "enum": ["implementation", "recreation"] },
    "partition": { "enum": ["development", "validation", "test"] },
    "reviewStatus": { "enum": ["teacher-estimate", "reviewed", "adjudicated"] },
    "category": {
      "enum": [
        "specification-comprehension-and-domain-learning",
        "repository-and-solution-setup",
        "architecture-and-technical-design",
        "production-implementation",
        "ui-implementation-and-represented-ux-decisions",
        "data-modeling-persistence-and-migrations",
        "external-integrations-and-protocols",
        "unit-testing",
        "integration-contract-and-component-testing",
        "end-to-end-and-ui-testing",
        "manual-validation-debugging-and-hardening",
        "documentation",
        "build-configuration-and-developer-tooling",
        "ci-cd-and-infrastructure-as-code",
        "security-and-accessibility",
        "packaging-deployment-and-release-artifacts",
        "self-review-and-system-integration"
      ]
    }
  }
}
