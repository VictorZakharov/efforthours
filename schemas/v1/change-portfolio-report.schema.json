{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eh:schema:v1:change-portfolio-report",
  "title": "EffortHours change portfolio report v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "estimatorVersion",
    "sourceChangeEstimatorVersion",
    "selection",
    "profile",
    "baseline",
    "isolatedEffort",
    "totalEffort",
    "categories",
    "repositoryGroups",
    "items",
    "adjustments",
    "diagnostics",
    "assumptions",
    "verification"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "estimatorVersion": { "type": "string", "minLength": 1 },
    "sourceChangeEstimatorVersion": { "type": "string", "minLength": 1 },
    "selection": { "$ref": "#/$defs/portfolioSelection" },
    "profile": { "enum": ["implementation", "recreation"] },
    "baseline": { "$ref": "urn:eh:schema:v1:change-estimate-report#/$defs/baseline" },
    "isolatedEffort": { "$ref": "urn:eh:schema:v1:change-estimate-report#/$defs/effortRange" },
    "totalEffort": { "$ref": "urn:eh:schema:v1:change-estimate-report#/$defs/effortRange" },
    "rateCard": { "$ref": "urn:eh:schema:v1:rate-card" },
    "totalCost": { "$ref": "urn:eh:schema:v1:change-estimate-report#/$defs/costRange" },
    "categories": {
      "type": "array",
      "items": { "$ref": "urn:eh:schema:v1:change-estimate-report#/$defs/categoryEstimate" }
    },
    "repositoryGroups": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/repositoryGroup" }
    },
    "aggregation": { "$ref": "#/$defs/aggregation" },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/item" }
    },
    "adjustments": {
      "type": "array",
      "items": { "$ref": "#/$defs/adjustment" }
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "urn:eh:schema:v1:diagnostic" }
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "verification": { "$ref": "urn:eh:schema:v1:change-estimate-report#/$defs/verification" }
  },
  "dependentRequired": {
    "rateCard": ["totalCost"],
    "totalCost": ["rateCard"]
  },
  "allOf": [
    {
      "if": {
        "required": ["estimatorVersion", "selection"],
        "properties": {
          "estimatorVersion": { "pattern": "^change-portfolio/0\\.2\\.0\\+" },
          "selection": {
            "required": ["kind", "manifestBased"],
            "properties": {
              "kind": { "const": "author-period" },
              "manifestBased": { "const": true }
            }
          }
        }
      },
      "then": { "required": ["aggregation"] }
    },
    {
      "if": { "required": ["aggregation"] },
      "then": {
        "properties": {
          "selection": {
            "required": ["kind", "manifestBased", "authorPeriodManifest"],
            "properties": {
              "kind": { "const": "author-period" },
              "manifestBased": { "const": true }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "portfolioSelection": {
      "type": "object",
      "required": ["schemaVersion", "kind", "manifestBased"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "kind": { "enum": ["pull-requests", "author-period"] },
        "manifestBased": { "type": "boolean" },
        "authorPeriod": { "$ref": "#/$defs/authorPeriod" },
        "authorPeriodManifest": { "$ref": "#/$defs/authorPeriodManifest" }
      },
      "additionalProperties": false
    },
    "authorPeriodManifest": {
      "type": "object",
      "required": [
        "manifestDigest",
        "sinceInclusive",
        "untilExclusive",
        "timeZone",
        "dateField",
        "mergePolicy",
        "coauthorPolicy",
        "contributorIds",
        "repositories",
        "intervalSemantics"
      ],
      "properties": {
        "manifestDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "sinceInclusive": { "type": "string", "format": "date-time" },
        "untilExclusive": { "type": "string", "format": "date-time" },
        "timeZone": { "type": "string", "minLength": 1, "maxLength": 256 },
        "dateField": { "enum": ["author", "committer"] },
        "mergePolicy": { "enum": ["exclude", "first-parent"] },
        "coauthorPolicy": { "enum": ["include", "exclude"] },
        "contributorIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/publicId" },
          "uniqueItems": true
        },
        "repositories": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/authorPeriodManifestRepository" }
        },
        "intervalSemantics": { "const": "since-inclusive-until-exclusive" }
      },
      "additionalProperties": false
    },
    "authorPeriodManifestRepository": {
      "type": "object",
      "required": ["id", "heads"],
      "properties": {
        "id": { "$ref": "#/$defs/publicId" },
        "heads": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/authorPeriodManifestHead" }
        }
      },
      "additionalProperties": false
    },
    "authorPeriodManifestHead": {
      "type": "object",
      "required": ["id", "objectId"],
      "properties": {
        "id": { "$ref": "#/$defs/publicId" },
        "objectId": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" }
      },
      "additionalProperties": false
    },
    "publicId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "authorPeriod": {
      "type": "object",
      "required": [
        "aliases",
        "sinceInclusive",
        "untilExclusive",
        "timeZone",
        "dateField",
        "mergePolicy",
        "coauthorPolicy",
        "headSelector",
        "headObjectId",
        "intervalSemantics"
      ],
      "properties": {
        "aliases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "sinceInclusive": { "type": "string", "format": "date-time" },
        "untilExclusive": { "type": "string", "format": "date-time" },
        "timeZone": { "type": "string", "minLength": 1 },
        "dateField": { "enum": ["author", "committer"] },
        "mergePolicy": { "enum": ["exclude", "first-parent"] },
        "coauthorPolicy": { "enum": ["include", "exclude"] },
        "headSelector": { "type": "string", "minLength": 1 },
        "headObjectId": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" },
        "intervalSemantics": { "const": "since-inclusive-until-exclusive" }
      },
      "additionalProperties": false
    },
    "attribution": {
      "type": "object",
      "required": ["kind", "mergeCommit", "parentCount", "ambiguityReasons"],
      "properties": {
        "kind": { "enum": ["pull-request", "direct-author", "coauthor"] },
        "selectedTimestamp": { "type": "string", "format": "date-time" },
        "mergeCommit": { "type": "boolean" },
        "parentCount": { "type": "integer", "minimum": 0 },
        "contributorMatches": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/contributorMatch" }
        },
        "headIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/publicId" },
          "uniqueItems": true
        },
        "ambiguityReasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "contributorMatch": {
      "type": "object",
      "required": ["contributorId", "kind"],
      "properties": {
        "contributorId": { "$ref": "#/$defs/publicId" },
        "kind": { "enum": ["direct-author", "coauthor"] }
      },
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "required": [
        "id",
        "selectorId",
        "repositoryId",
        "baseContextId",
        "selection",
        "evidenceDigest",
        "patchDigest",
        "representedPathCount",
        "isolatedEffort",
        "allocatedExpectedHours",
        "categories",
        "attribution",
        "uncertaintyReasons"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "selectorId": { "type": "string", "minLength": 1 },
        "repositoryId": { "type": "string", "minLength": 1 },
        "baseContextId": { "type": "string", "minLength": 1 },
        "selection": { "$ref": "urn:eh:schema:v1:change-evidence#/$defs/selection" },
        "evidenceDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "patchDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "representedPathCount": { "type": "integer", "minimum": 0 },
        "isolatedEffort": { "$ref": "urn:eh:schema:v1:change-estimate-report#/$defs/effortRange" },
        "allocatedExpectedHours": { "type": "number", "minimum": 0 },
        "allocatedExpectedCost": { "type": "number", "minimum": 0 },
        "categories": {
          "type": "array",
          "items": { "$ref": "urn:eh:schema:v1:change-estimate-report#/$defs/categoryEstimate" }
        },
        "attribution": { "$ref": "#/$defs/attribution" },
        "duplicateOfItemId": { "type": "string", "minLength": 1 },
        "uncertaintyReasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "baseContext": {
      "type": "object",
      "required": ["id", "baseObjectId", "itemIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "baseObjectId": { "type": "string", "minLength": 1 },
        "itemIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "repositoryGroup": {
      "type": "object",
      "required": [
        "id",
        "repositoryId",
        "orderPolicy",
        "baseContexts",
        "itemIds",
        "isolatedEffort",
        "normalizedEffort",
        "categories",
        "assessment",
        "adjustmentIds",
        "uncertaintyReasons"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "repositoryId": { "type": "string", "minLength": 1 },
        "orderPolicy": { "enum": ["order-independent", "chronological-selected-commits"] },
        "baseContexts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/baseContext" }
        },
        "itemIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "isolatedEffort": { "$ref": "urn:eh:schema:v1:change-estimate-report#/$defs/effortRange" },
        "normalizedEffort": { "$ref": "urn:eh:schema:v1:change-estimate-report#/$defs/effortRange" },
        "categories": {
          "type": "array",
          "items": { "$ref": "urn:eh:schema:v1:change-estimate-report#/$defs/categoryEstimate" }
        },
        "assessment": { "type": "string", "minLength": 1 },
        "adjustmentIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "uncertaintyReasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "aggregation": {
      "type": "object",
      "required": ["policy", "contributors", "contributorGroups", "repositories"],
      "properties": {
        "policy": { "const": "exclusive-contributor-and-head-match-sets/1.0.0" },
        "contributors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/contributorSummary" }
        },
        "contributorGroups": {
          "type": "array",
          "minItems": 1,
          "maxItems": 192,
          "items": { "$ref": "#/$defs/contributorGroup" }
        },
        "repositories": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/repositorySummary" }
        }
      },
      "additionalProperties": false
    },
    "contributorSummary": {
      "type": "object",
      "required": [
        "contributorId",
        "selectedCommitCount",
        "directAuthorMatchCount",
        "coauthorMatchCount",
        "singleContributorSelectedCommitCount",
        "sharedContributorSelectedCommitCount",
        "noSelectedCommits",
        "singleContributorGroupId",
        "sharedContributorGroupIds",
        "uncertaintyReasons"
      ],
      "properties": {
        "contributorId": { "$ref": "#/$defs/publicId" },
        "selectedCommitCount": { "type": "integer", "minimum": 0 },
        "directAuthorMatchCount": { "type": "integer", "minimum": 0 },
        "coauthorMatchCount": { "type": "integer", "minimum": 0 },
        "singleContributorSelectedCommitCount": { "type": "integer", "minimum": 0 },
        "sharedContributorSelectedCommitCount": { "type": "integer", "minimum": 0 },
        "noSelectedCommits": { "type": "boolean" },
        "singleContributorGroupId": { "type": "string", "minLength": 1 },
        "sharedContributorGroupIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "uncertaintyReasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "contributorGroup": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "contributorIds",
        "itemIds",
        "selectedCommitCount",
        "directAuthorMatchCount",
        "coauthorMatchCount",
        "isolatedEffort",
        "normalizedEffort",
        "reconciliationDelta",
        "repositoryAllocations",
        "uncertaintyReasons"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["single-contributor", "shared-contributors"] },
        "contributorIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/publicId" },
          "uniqueItems": true
        },
        "itemIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "selectedCommitCount": { "type": "integer", "minimum": 0 },
        "directAuthorMatchCount": { "type": "integer", "minimum": 0 },
        "coauthorMatchCount": { "type": "integer", "minimum": 0 },
        "isolatedEffort": { "$ref": "urn:eh:schema:v1:change-estimate-report#/$defs/effortRange" },
        "normalizedEffort": { "$ref": "urn:eh:schema:v1:change-estimate-report#/$defs/effortRange" },
        "reconciliationDelta": { "$ref": "urn:eh:schema:v1:change-estimate-report#/$defs/signedEffortRange" },
        "repositoryAllocations": {
          "type": "array",
          "items": { "$ref": "#/$defs/contributorRepositoryAllocation" }
        },
        "uncertaintyReasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "contributorRepositoryAllocation": {
      "type": "object",
      "required": [
        "id",
        "repositoryId",
        "repositoryGroupId",
        "itemIds",
        "isolatedEffort",
        "normalizedEffort",
        "reconciliationDelta",
        "adjustmentIds",
        "uncertaintyReasons"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "repositoryId": { "$ref": "#/$defs/publicId" },
        "repositoryGroupId": { "type": "string", "minLength": 1 },
        "itemIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "isolatedEffort": { "$ref": "urn:eh:schema:v1:change-estimate-report#/$defs/effortRange" },
        "normalizedEffort": { "$ref": "urn:eh:schema:v1:change-estimate-report#/$defs/effortRange" },
        "reconciliationDelta": { "$ref": "urn:eh:schema:v1:change-estimate-report#/$defs/signedEffortRange" },
        "adjustmentIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "uncertaintyReasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "repositorySummary": {
      "type": "object",
      "required": [
        "repositoryId",
        "selectedCommitCount",
        "directAuthorMatchCount",
        "coauthorMatchCount",
        "sharedContributorSelectedCommitCount",
        "sharedHeadSelectedCommitCount",
        "noSelectedCommits",
        "isolatedEffort",
        "normalizedEffort",
        "adjustmentIds",
        "heads",
        "headGroups",
        "uncertaintyReasons"
      ],
      "properties": {
        "repositoryId": { "$ref": "#/$defs/publicId" },
        "selectedCommitCount": { "type": "integer", "minimum": 0 },
        "directAuthorMatchCount": { "type": "integer", "minimum": 0 },
        "coauthorMatchCount": { "type": "integer", "minimum": 0 },
        "sharedContributorSelectedCommitCount": { "type": "integer", "minimum": 0 },
        "sharedHeadSelectedCommitCount": { "type": "integer", "minimum": 0 },
        "noSelectedCommits": { "type": "boolean" },
        "isolatedEffort": { "$ref": "urn:eh:schema:v1:change-estimate-report#/$defs/effortRange" },
        "normalizedEffort": { "$ref": "urn:eh:schema:v1:change-estimate-report#/$defs/effortRange" },
        "adjustmentIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "heads": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/headSummary" }
        },
        "headGroups": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/headGroup" }
        },
        "uncertaintyReasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "headSummary": {
      "type": "object",
      "required": [
        "headId",
        "reachableSelectedCommitCount",
        "uniqueSelectedCommitCount",
        "sharedSelectedCommitCount",
        "noUniqueSelectedCommits",
        "singleHeadGroupId",
        "sharedHeadGroupIds"
      ],
      "properties": {
        "headId": { "$ref": "#/$defs/publicId" },
        "reachableSelectedCommitCount": { "type": "integer", "minimum": 0 },
        "uniqueSelectedCommitCount": { "type": "integer", "minimum": 0 },
        "sharedSelectedCommitCount": { "type": "integer", "minimum": 0 },
        "noUniqueSelectedCommits": { "type": "boolean" },
        "singleHeadGroupId": { "type": "string", "minLength": 1 },
        "sharedHeadGroupIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "headGroup": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "headIds",
        "itemIds",
        "selectedCommitCount",
        "isolatedEffort",
        "normalizedEffort",
        "reconciliationDelta",
        "adjustmentIds",
        "uncertaintyReasons"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["single-head", "shared-heads"] },
        "headIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/publicId" },
          "uniqueItems": true
        },
        "itemIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "selectedCommitCount": { "type": "integer", "minimum": 0 },
        "isolatedEffort": { "$ref": "urn:eh:schema:v1:change-estimate-report#/$defs/effortRange" },
        "normalizedEffort": { "$ref": "urn:eh:schema:v1:change-estimate-report#/$defs/effortRange" },
        "reconciliationDelta": { "$ref": "urn:eh:schema:v1:change-estimate-report#/$defs/signedEffortRange" },
        "adjustmentIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "uncertaintyReasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "adjustment": {
      "type": "object",
      "required": ["id", "kind", "effortDelta", "reason", "itemIds", "affectedPathCount"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["exact-duplicate", "shared-context", "overlap", "revert", "interaction"] },
        "effortDelta": { "$ref": "urn:eh:schema:v1:change-estimate-report#/$defs/signedEffortRange" },
        "reason": { "type": "string", "minLength": 1 },
        "itemIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "affectedPathCount": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
