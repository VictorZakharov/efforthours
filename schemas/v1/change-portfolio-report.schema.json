{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eh:schema:v1:change-portfolio-report",
  "title": "EffortHours change portfolio report v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "estimatorVersion",
    "sourceChangeEstimatorVersion",
    "selection",
    "profile",
    "baseline",
    "isolatedEffort",
    "totalEffort",
    "categories",
    "repositoryGroups",
    "items",
    "adjustments",
    "diagnostics",
    "assumptions",
    "verification"
  ],
  "properties": {
    "replayAllocations": { "type": "array", "minItems": 1, "maxItems": 8192, "items": { "$ref": "#/$defs/replayAllocation" } },
    "dailyNormalization": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "timeZone", "days"],
      "properties": {
    "replayAllocations": { "type": "array", "minItems": 1, "maxItems": 8192, "items": { "$ref": "#/$defs/replayAllocation" } },
        "protocol": { "enum": ["independent-local-day-change/1.0.0", "independent-local-day-change/1.1.0"] },
        "timeZone": { "type": "string", "minLength": 1 },
        "days": {
          "type": "array", "maxItems": 512,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["date", "repositoryGroups", "adjustments"],
            "properties": {
    "replayAllocations": { "type": "array", "minItems": 1, "maxItems": 8192, "items": { "$ref": "#/$defs/replayAllocation" } },
              "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
              "repositoryGroups": { "type": "array", "items": { "$ref": "#/$defs/repositoryGroup" } },
              "adjustments": { "type": "array", "items": { "$ref": "#/$defs/adjustment" } }
            }
          }
        }
      }
    },
    "schemaVersion": { "const": "1.0.0" },
    "estimatorVersion": { "type": "string", "minLength": 1 },
    "sourceChangeEstimatorVersion": { "type": "string", "minLength": 1 },
    "selection": { "$ref": "#/$defs/portfolioSelection" },
    "profile": { "enum": ["implementation", "recreation"] },
    "baseline": { "$ref": "urn:eh:schema:v1:change-estimate-report#/$defs/baseline" },
    "isolatedEffort": { "$ref": "urn:eh:schema:v1:change-estimate-report#/$defs/effortRange" },
    "totalEffort": { "$ref": "urn:eh:schema:v1:change-estimate-report#/$defs/effortRange" },
    "rateCard": { "$ref": "urn:eh:schema:v1:rate-card" },
    "totalCost": { "$ref": "urn:eh:schema:v1:change-estimate-report#/$defs/costRange" },
    "categories": {
      "type": "array",
      "items": { "$ref": "urn:eh:schema:v1:change-estimate-report#/$defs/categoryEstimate" }
    },
    "repositoryGroups": {
      "type": "array",
      "minItems": 0,
      "items": { "$ref": "#/$defs/repositoryGroup" }
    },
    "aggregation": { "$ref": "#/$defs/aggregation" },
    "items": {
      "type": "array",
      "minItems": 0,
      "maxItems": 640000,
      "items": { "$ref": "#/$defs/item" }
    },
    "adjustments": {
      "type": "array",
      "items": { "$ref": "#/$defs/adjustment" }
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "urn:eh:schema:v1:diagnostic" }
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "verification": { "$ref": "urn:eh:schema:v1:change-estimate-report#/$defs/verification" }
  },
  "dependentRequired": {
    "rateCard": ["totalCost"],
    "totalCost": ["rateCard"]
  },
  "allOf": [
    {
      "if": {
        "required": ["estimatorVersion", "selection"],
        "properties": {
    "replayAllocations": { "type": "array", "minItems": 1, "maxItems": 8192, "items": { "$ref": "#/$defs/replayAllocation" } },
          "estimatorVersion": { "pattern": "^change-portfolio/0\\.[23456]\\.[0-9]+\\+" },
          "selection": {
            "required": ["kind", "manifestBased"],
            "properties": {
    "replayAllocations": { "type": "array", "minItems": 1, "maxItems": 8192, "items": { "$ref": "#/$defs/replayAllocation" } },
              "kind": { "const": "author-period" },
              "manifestBased": { "const": true }
            }
          }
        }
      },
      "then": { "required": ["aggregation"] }
    },
    {
      "if": { "required": ["aggregation"] },
      "then": {
        "properties": {
    "replayAllocations": { "type": "array", "minItems": 1, "maxItems": 8192, "items": { "$ref": "#/$defs/replayAllocation" } },
          "selection": {
            "required": ["kind", "manifestBased", "authorPeriodManifest"],
            "properties": {
    "replayAllocations": { "type": "array", "minItems": 1, "maxItems": 8192, "items": { "$ref": "#/$defs/replayAllocation" } },
              "kind": { "const": "author-period" },
              "manifestBased": { "const": true }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "replayEvent": {
      "type": "object",
      "required": [
        "attributionPolicy",
        "id",
        "oldBaseObjectId",
        "originalObjectId",
        "newBaseObjectId",
        "rewrittenObjectId"
      ],
      "properties": {
    "replayAllocations": { "type": "array", "minItems": 1, "maxItems": 8192, "items": { "$ref": "#/$defs/replayAllocation" } },
        "attributionPolicy": {
          "const": "declared-replay-range/1.0.0"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "oldBaseObjectId": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        },
        "originalObjectId": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        },
        "newBaseObjectId": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        },
        "rewrittenObjectId": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        },
        "replayObjectId": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        },
        "replayProvenanceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "eventTimestamp": {
          "type": "string",
          "format": "date-time"
        },
        "eventProvenanceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        }
      },
      "dependentRequired": { "replayObjectId": ["replayProvenanceId"], "replayProvenanceId": ["replayObjectId"], "eventTimestamp": ["eventProvenanceId"], "eventProvenanceId": ["eventTimestamp"] },
      "additionalProperties": false
    },
    "replayAttribution": {
      "type": "object",
      "required": [
        "eventId",
        "role",
        "originalSelectedTimestamp",
        "supportOnly"
      ],
      "properties": {
    "replayAllocations": { "type": "array", "minItems": 1, "maxItems": 8192, "items": { "$ref": "#/$defs/replayAllocation" } },
        "eventId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "role": {
          "enum": [
            "original",
            "retained"
          ]
        },
        "originalSelectedTimestamp": {
          "type": "string",
          "format": "date-time"
        },
        "supportOnly": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "replayAllocation": {
      "type": "object",
      "required": [
        "policy",
        "evidence",
        "status",
        "availableJointExpectedHours",
        "allocationCapped"
      ],
      "properties": {
    "replayAllocations": { "type": "array", "minItems": 1, "maxItems": 8192, "items": { "$ref": "#/$defs/replayAllocation" } },
        "policy": {
          "const": "declared-replay-range/1.0.0"
        },
        "evidence": {
          "type": "object",
          "required": [
            "event",
            "review",
            "originalObjectIds",
            "retainedObjectIds"
          ],
          "properties": {
    "replayAllocations": { "type": "array", "minItems": 1, "maxItems": 8192, "items": { "$ref": "#/$defs/replayAllocation" } },
            "event": {
              "$ref": "#/$defs/replayEvent"
            },
            "review": {
              "$ref": "urn:eh:schema:v1:change-rewrite-review-report"
            },
            "originalObjectIds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1024,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
              }
            },
            "retainedObjectIds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1024,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
              }
            }
          },
          "additionalProperties": false
        },
        "status": {
          "enum": [
            "allocated-under-declared-replay",
            "event-outside-period",
            "unresolved-replay-evidence",
            "unresolved-event-date"
          ]
        },
        "availableJointExpectedHours": {
          "type": "number",
          "minimum": 0
        },
        "standaloneNovelExpectedHours": {
          "type": "number",
          "minimum": 0
        },
        "allocatedEventExpectedHours": {
          "type": "number",
          "minimum": 0
        },
        "allocationCapped": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "portfolioSelection": {
      "type": "object",
      "required": ["schemaVersion", "kind", "manifestBased"],
      "properties": {
    "replayAllocations": { "type": "array", "minItems": 1, "maxItems": 8192, "items": { "$ref": "#/$defs/replayAllocation" } },
        "schemaVersion": { "const": "1.0.0" },
        "kind": { "enum": ["pull-requests", "author-period"] },
        "manifestBased": { "type": "boolean" },
        "authorPeriod": { "$ref": "#/$defs/authorPeriod" },
        "authorPeriodManifest": { "$ref": "#/$defs/authorPeriodManifest" }
      },
      "additionalProperties": false
    },
    "authorPeriodManifest": {
      "type": "object",
      "required": [
        "manifestDigest",
        "sinceInclusive",
        "untilExclusive",
        "timeZone",
        "dateField",
        "mergePolicy",
        "coauthorPolicy",
        "contributorIds",
        "repositories",
        "intervalSemantics"
      ],
      "properties": {
    "replayAllocations": { "type": "array", "minItems": 1, "maxItems": 8192, "items": { "$ref": "#/$defs/replayAllocation" } },
        "manifestDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "sinceInclusive": { "type": "string", "format": "date-time" },
        "untilExclusive": { "type": "string", "format": "date-time" },
        "timeZone": { "type": "string", "minLength": 1, "maxLength": 256 },
        "dateField": { "enum": ["author", "committer"] },
        "mergePolicy": { "enum": ["exclude", "first-parent"] },
        "coauthorPolicy": { "enum": ["include", "exclude"] },
        "contributorIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/publicId" },
          "uniqueItems": true
        },
        "repositories": {
          "type": "array",
          "minItems": 0,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/authorPeriodManifestRepository" }
        },
        "intervalSemantics": { "const": "since-inclusive-until-exclusive" }
      },
      "additionalProperties": false
    },
    "authorPeriodManifestRepository": {
      "type": "object",
      "required": ["id", "heads"],
      "properties": {
    "replayAllocations": { "type": "array", "minItems": 1, "maxItems": 8192, "items": { "$ref": "#/$defs/replayAllocation" } },
        "id": { "$ref": "#/$defs/publicId" },
        "heads": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": { "$ref": "#/$defs/authorPeriodManifestHead" }
        }
      },
      "additionalProperties": false
    },
    "authorPeriodManifestHead": {
      "type": "object",
      "required": ["id", "objectId"],
      "properties": {
    "replayAllocations": { "type": "array", "minItems": 1, "maxItems": 8192, "items": { "$ref": "#/$defs/replayAllocation" } },
        "id": { "$ref": "#/$defs/publicId" },
        "objectId": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" }
      },
      "additionalProperties": false
    },
    "publicId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "authorPeriod": {
      "type": "object",
      "required": [
        "aliases",
        "sinceInclusive",
        "untilExclusive",
        "timeZone",
        "dateField",
        "mergePolicy",
        "coauthorPolicy",
        "headSelector",
        "headObjectId",
        "intervalSemantics"
      ],
      "properties": {
    "replayAllocations": { "type": "array", "minItems": 1, "maxItems": 8192, "items": { "$ref": "#/$defs/replayAllocation" } },
        "aliases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "sinceInclusive": { "type": "string", "format": "date-time" },
        "untilExclusive": { "type": "string", "format": "date-time" },
        "timeZone": { "type": "string", "minLength": 1 },
        "dateField": { "enum": ["author", "committer"] },
        "mergePolicy": { "enum": ["exclude", "first-parent"] },
        "coauthorPolicy": { "enum": ["include", "exclude"] },
        "headSelector": { "type": "string", "minLength": 1 },
        "headObjectId": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" },
        "intervalSemantics": { "const": "since-inclusive-until-exclusive" }
      },
      "additionalProperties": false
    },
    "rewriteAttribution": {
      "type": "object",
      "required": ["evidence", "originalAuthorTimestamp", "rewrittenCommitterTimestamp", "role", "supportOnly", "basis", "confidence", "treatment"],
      "properties": {
    "replayAllocations": { "type": "array", "minItems": 1, "maxItems": 8192, "items": { "$ref": "#/$defs/replayAllocation" } },
        "evidence": { "$ref": "urn:eh:schema:v1:change-author-period-manifest#/$defs/rewriteEvent" },
        "originalAuthorTimestamp": { "type": "string", "format": "date-time" },
        "rewrittenCommitterTimestamp": { "type": "string", "format": "date-time" },
        "role": { "enum": ["original", "rewritten"] },
        "supportOnly": { "type": "boolean" },
        "basis": { "const": "caller-declared-immutable-pair" },
        "confidence": { "const": "declared-not-verified-workday" },
        "allocationBasis": { "const": "joint-retained-budget-remainder" },
        "treatment": { "enum": ["evidence-support", "no-retained-increment", "original-contribution", "retained-resolution-contribution"] }
      },
      "additionalProperties": false
    },
    "attribution": {
      "type": "object",
      "required": ["kind", "mergeCommit", "parentCount", "ambiguityReasons"],
      "properties": {
        "replay": { "$ref": "#/$defs/replayAttribution" },
    "replayAllocations": { "type": "array", "minItems": 1, "maxItems": 8192, "items": { "$ref": "#/$defs/replayAllocation" } },
        "rewrite": { "$ref": "#/$defs/rewriteAttribution" },
        "kind": { "enum": ["pull-request", "direct-author", "coauthor"] },
        "selectedTimestamp": { "type": "string", "format": "date-time" },
        "mergeCommit": { "type": "boolean" },
        "parentCount": { "type": "integer", "minimum": 0 },
        "contributorMatches": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/contributorMatch" }
        },
        "headIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": { "$ref": "#/$defs/publicId" },
          "uniqueItems": true
        },
        "ambiguityReasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "contributorMatch": {
      "type": "object",
      "required": ["contributorId", "kind"],
      "properties": {
    "replayAllocations": { "type": "array", "minItems": 1, "maxItems": 8192, "items": { "$ref": "#/$defs/replayAllocation" } },
        "contributorId": { "$ref": "#/$defs/publicId" },
        "kind": { "enum": ["direct-author", "coauthor"] }
      },
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "required": [
        "id",
        "selectorId",
        "repositoryId",
        "baseContextId",
        "selection",
        "evidenceDigest",
        "patchDigest",
        "representedPathCount",
        "isolatedEffort",
        "allocatedExpectedHours",
        "categories",
        "attribution",
        "uncertaintyReasons"
      ],
      "properties": {
    "replayAllocations": { "type": "array", "minItems": 1, "maxItems": 8192, "items": { "$ref": "#/$defs/replayAllocation" } },
        "id": { "type": "string", "minLength": 1 },
        "selectorId": { "type": "string", "minLength": 1 },
        "repositoryId": { "type": "string", "minLength": 1 },
        "baseContextId": { "type": "string", "minLength": 1 },
        "selection": { "$ref": "urn:eh:schema:v1:change-evidence#/$defs/selection" },
        "evidenceDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "patchDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "analyzedPathCount": { "type": "integer", "minimum": 0 },
        "representedPathCount": { "type": "integer", "minimum": 0 },
        "isolatedEffort": { "$ref": "urn:eh:schema:v1:change-estimate-report#/$defs/effortRange" },
        "allocatedExpectedHours": { "type": "number", "minimum": 0 },
        "allocatedExpectedCost": { "type": "number", "minimum": 0 },
        "categories": {
          "type": "array",
          "items": { "$ref": "urn:eh:schema:v1:change-estimate-report#/$defs/categoryEstimate" }
        },
        "attribution": { "$ref": "#/$defs/attribution" },
        "duplicateOfItemId": { "type": "string", "minLength": 1 },
        "exactComposition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocol", "itemIds", "patchDigest"],
          "properties": {
    "replayAllocations": { "type": "array", "minItems": 1, "maxItems": 8192, "items": { "$ref": "#/$defs/replayAllocation" } },
            "protocol": { "const": "exact-retained-composition/1.0.0" },
            "itemIds": {
              "type": "array", "minItems": 2, "maxItems": 256, "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "patchDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        },
        "uncertaintyReasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "baseContext": {
      "type": "object",
      "required": ["id", "baseObjectId", "itemIds"],
      "properties": {
    "replayAllocations": { "type": "array", "minItems": 1, "maxItems": 8192, "items": { "$ref": "#/$defs/replayAllocation" } },
        "id": { "type": "string", "minLength": 1 },
        "baseObjectId": { "type": "string", "minLength": 1 },
        "itemIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "repositoryGroup": {
      "type": "object",
      "required": [
        "id",
        "repositoryId",
        "orderPolicy",
        "baseContexts",
        "itemIds",
        "isolatedEffort",
        "normalizedEffort",
        "categories",
        "assessment",
        "adjustmentIds",
        "uncertaintyReasons"
      ],
      "properties": {
    "replayAllocations": { "type": "array", "minItems": 1, "maxItems": 8192, "items": { "$ref": "#/$defs/replayAllocation" } },
        "id": { "type": "string", "minLength": 1 },
        "repositoryId": { "type": "string", "minLength": 1 },
        "orderPolicy": { "enum": ["order-independent", "chronological-selected-commits"] },
        "baseContexts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/baseContext" }
        },
        "itemIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "isolatedEffort": { "$ref": "urn:eh:schema:v1:change-estimate-report#/$defs/effortRange" },
        "normalizedEffort": { "$ref": "urn:eh:schema:v1:change-estimate-report#/$defs/effortRange" },
        "categories": {
          "type": "array",
          "items": { "$ref": "urn:eh:schema:v1:change-estimate-report#/$defs/categoryEstimate" }
        },
        "assessment": { "type": "string", "minLength": 1 },
        "adjustmentIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "uncertaintyReasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "aggregation": {
      "type": "object",
      "required": ["policy", "contributors", "contributorGroups", "repositories"],
      "properties": {
    "replayAllocations": { "type": "array", "minItems": 1, "maxItems": 8192, "items": { "$ref": "#/$defs/replayAllocation" } },
        "policy": { "const": "exclusive-contributor-and-head-match-sets/1.0.0" },
        "contributors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/contributorSummary" }
        },
        "contributorGroups": {
          "type": "array",
          "minItems": 1,
          "maxItems": 192,
          "items": { "$ref": "#/$defs/contributorGroup" }
        },
        "repositories": {
          "type": "array",
          "minItems": 0,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/repositorySummary" }
        }
      },
      "additionalProperties": false
    },
    "contributorSummary": {
      "type": "object",
      "required": [
        "contributorId",
        "selectedCommitCount",
        "directAuthorMatchCount",
        "coauthorMatchCount",
        "singleContributorSelectedCommitCount",
        "sharedContributorSelectedCommitCount",
        "noSelectedCommits",
