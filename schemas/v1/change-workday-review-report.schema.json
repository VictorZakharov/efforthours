{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eh:schema:v1:change-workday-review-report",
  "title": "Retained workday evidence review v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "policy",
    "status",
    "sourceSemanticDigest",
    "sourcePortfolioDigest",
    "workRecordInputDigest",
    "timeZone",
    "contributorId",
    "referenceHoursPerDay",
    "repositoryIds",
    "days",
    "boundary"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "policy": {
      "enum": [
        "retained-workday-review/1.0.0",
        "declared-workday-review/1.0.0"
      ]
    },
    "status": {
      "enum": [
        "unresolved",
        "reviewed-retained-attribution",
        "reviewed-declared-workdays",
        "declared-workdays-no-retained-effort"
      ]
    },
    "sourceSemanticDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sourcePortfolioDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "workRecordInputDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timeZone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "contributorId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "attributionCompleteness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "declaredEventStatus",
        "missingEventDateCount",
        "missingReplayBaselineCount",
        "originalWorkdayStatus",
        "intermediateHistoryStatus"
      ],
      "properties": {
        "policy": {
          "const": "retained-attribution-completeness/1.0.0"
        },
        "declaredEventStatus": {
          "enum": [
            "not-declared",
            "available",
            "unresolved"
          ]
        },
        "missingEventDateCount": {
          "type": "integer",
          "minimum": 0
        },
        "missingReplayBaselineCount": {
          "type": "integer",
          "minimum": 0
        },
        "originalWorkdayStatus": {
          "const": "unresolved-original-workday"
        },
        "intermediateHistoryStatus": {
          "const": "unknown"
        }
      }
    },
    "entryPolicy": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "equal-matched-entries/1.0.0",
            "equal-declared-day-entries/1.0.0"
          ]
        }
      ]
    },
    "referenceHoursPerDay": {
      "const": 8
    },
    "repositoryIds": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
      }
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "required": [
          "date",
          "bucketId",
          "status",
          "retainedEvidenceStatus",
          "originalWorkdayStatus",
          "sourceAttributedExpectedHours",
          "records"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "format": "date"
          },
          "bucketId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "status": {
            "enum": [
              "unresolved-event-attribution",
              "retained-attribution-available",
              "unresolved-workday",
              "missing-work-record",
              "repository-scope-unresolved",
              "mixed-work-records-unresolved",
              "no-implementation-record",
              "declared-workday-allocation",
              "declared-workday-no-retained-effort",
              "no-declared-workday"
            ]
          },
          "retainedEvidenceStatus": {
            "enum": [
              "measured-retained-change",
              "no-retained-change",
              "scope-excluded",
              "normalized-zero",
              "reconciled-zero"
            ]
          },
          "originalWorkdayStatus": {
            "const": "unresolved-original-workday"
          },
          "sourceAttributedExpectedHours": {
            "type": "number",
            "minimum": 0
          },
          "matchedDailyMultiplier": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "multipleOf": 0.01
              },
              {
                "type": "null"
              }
            ]
          },
          "records": {
            "type": "array",
            "minItems": 0,
            "maxItems": 4096,
            "items": {
              "type": "object",
              "required": [
                "recordId",
                "kind",
                "status",
                "repositoryIds"
              ],
              "properties": {
                "recordId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                },
                "kind": {
                  "enum": [
                    "implementation",
                    "meeting",
                    "pto",
                    "mixed"
                  ]
                },
                "status": {
                  "enum": [
                    "unresolved-event-attribution",
                    "retained-attribution-available",
                    "unresolved-workday",
                    "missing-work-record",
                    "repository-scope-unresolved",
                    "mixed-work-records-unresolved",
                    "no-implementation-record",
                    "excluded-non-implementation",
                    "declared-workday-allocation",
                    "declared-workday-no-retained-effort",
                    "no-declared-workday"
                  ]
                },
                "repositoryIds": {
                  "type": "array",
                  "minItems": 0,
                  "maxItems": 256,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                  }
                },
                "allocatedMultiplierContribution": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "multipleOf": 0.01
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "workdayEvidenceBasis": {
            "enum": [
              "external-work-record",
              "not-declared"
            ]
          },
          "allocatedExpectedHours": {
            "type": "number",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "boundary": {
      "enum": [
        "Experimental, uncalibrated retained-date EHE review; original workdays remain unresolved. Entry contributions are optional allocations, not actual labor, causal credit, or timesheet values. Logged hours never weight EHE; the reference denominator is eight hours.",
        "Experimental, uncalibrated EHE projection over externally declared work-record dates. Dates are not recovered Git workdays or verified labor; source event and intermediate-history uncertainty remain. Logged hours never weight EHE; the reference denominator is eight hours and entry values conserve one rounded period multiplier."
      ]
    },
    "workdayResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "manifest",
        "allocation"
      ],
      "properties": {
        "policy": {
          "const": "declared-workday-resolution/1.0.0"
        },
        "manifest": {
          "$ref": "urn:eh:schema:v1:change-workday-manifest"
        },
        "allocation": {
          "$ref": "urn:eh:schema:v1:change-workday-allocation-report"
        },
        "expectedMultiplierTotal": {
          "type": "number",
          "minimum": 0,
          "multipleOf": 0.01
        }
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "policy": {
            "const": "declared-workday-review/1.0.0"
          }
        }
      },
      "then": {
        "required": [
          "workdayResolution"
        ],
        "properties": {
          "boundary": {
            "const": "Experimental, uncalibrated EHE projection over externally declared work-record dates. Dates are not recovered Git workdays or verified labor; source event and intermediate-history uncertainty remain. Logged hours never weight EHE; the reference denominator is eight hours and entry values conserve one rounded period multiplier."
          },
          "status": {
            "enum": [
              "reviewed-declared-workdays",
              "declared-workdays-no-retained-effort"
            ]
          },
          "entryPolicy": {
            "enum": [
              null,
              "equal-declared-day-entries/1.0.0"
            ]
          },
          "days": {
            "items": {
              "required": [
                "workdayEvidenceBasis",
                "allocatedExpectedHours"
              ]
            }
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "workdayResolution"
          ]
        },
        "properties": {
          "boundary": {
            "const": "Experimental, uncalibrated retained-date EHE review; original workdays remain unresolved. Entry contributions are optional allocations, not actual labor, causal credit, or timesheet values. Logged hours never weight EHE; the reference denominator is eight hours."
          },
          "status": {
            "enum": [
              "unresolved",
              "reviewed-retained-attribution"
            ]
          },
          "entryPolicy": {
            "enum": [
              null,
              "equal-matched-entries/1.0.0"
            ]
          },
          "days": {
            "items": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "workdayEvidenceBasis"
                    ]
                  },
                  {
                    "required": [
                      "allocatedExpectedHours"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
