{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fairbill:schema:v1:calibration-corpus",
  "title": "Fairbill calibration corpus v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "version",
    "description",
    "rubric",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "rubric": {
      "$ref": "#/$defs/rubric"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "rubric": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "required": [
        "id",
        "repository",
        "profile",
        "baselineId",
        "partition",
        "sourceEstimatorVersion",
        "sourceEstimateDigest",
        "source",
        "review",
        "targets"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "$ref": "#/$defs/repository"
        },
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "baselineId": {
          "type": "string",
          "minLength": 1
        },
        "partition": {
          "$ref": "#/$defs/partition"
        },
        "sourceEstimatorVersion": {
          "type": "string",
          "minLength": 1
        },
        "sourceEstimateDigest": {
          "type": "string",
          "pattern": "^sha256:.+"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "review": {
          "$ref": "#/$defs/review"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/target"
          }
        }
      },
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "required": [
        "id",
        "name",
        "sourceDigest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sourceDigest": {
          "type": "string",
          "pattern": "^sha256:.+"
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "dataClassification",
        "sourceReference",
        "revision",
        "licenseExpression",
        "redistributionAllowed"
      ],
      "properties": {
        "dataClassification": {
          "enum": [
            "public-redistributable",
            "private",
            "synthetic"
          ]
        },
        "sourceReference": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "licenseExpression": {
          "type": "string",
          "minLength": 1
        },
        "redistributionAllowed": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": [
        "status",
        "completedOn",
        "reviewers"
      ],
      "properties": {
        "status": {
          "enum": [
            "teacher-estimate",
            "reviewed",
            "adjudicated"
          ]
        },
        "completedOn": {
          "type": "string",
          "format": "date"
        },
        "reviewers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/reviewer"
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "reviewer": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "role"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "human",
            "host-ai"
          ]
        },
        "role": {
          "enum": [
            "teacher",
            "reviewer",
            "adjudicator"
          ]
        },
        "modelId": {
          "type": "string",
          "minLength": 1
        },
        "modelVersion": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": [
        "id",
        "category",
        "title",
        "scope",
        "sourceWorkItemIds",
        "evidenceIds",
        "hours",
        "rationale",
        "uncertaintyReasons"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "$ref": "#/$defs/category"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "sourceWorkItemIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hours": {
          "$ref": "#/$defs/effortRange"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "uncertaintyReasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sizeException": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "effortRange": {
      "type": "object",
      "required": [
        "low",
        "expected",
        "high"
      ],
      "properties": {
        "low": {
          "type": "number",
          "minimum": 0
        },
        "expected": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "high": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "profile": {
      "enum": [
        "implementation",
        "recreation"
      ]
    },
    "partition": {
      "enum": [
        "development",
        "validation",
        "test"
      ]
    },
    "category": {
      "enum": [
        "specification-comprehension-and-domain-learning",
        "repository-and-solution-setup",
        "architecture-and-technical-design",
        "production-implementation",
        "ui-implementation-and-represented-ux-decisions",
        "data-modeling-persistence-and-migrations",
        "external-integrations-and-protocols",
        "unit-testing",
        "integration-contract-and-component-testing",
        "end-to-end-and-ui-testing",
        "manual-validation-debugging-and-hardening",
        "documentation",
        "build-configuration-and-developer-tooling",
        "ci-cd-and-infrastructure-as-code",
        "security-and-accessibility",
        "packaging-deployment-and-release-artifacts",
        "self-review-and-system-integration"
      ]
    }
  }
}
