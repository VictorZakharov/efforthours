{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eh:schema:v1:repository-evidence",
  "title": "EffortHours repository evidence v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "repository",
    "facts",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "urn:eh:schema:v1:diagnostic"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "repository": {
      "type": "object",
      "required": [
        "name",
        "scope",
        "ecosystems"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "ecosystems": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "sourceDigest": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "sourceKind",
        "analyzer",
        "analyzerVersion",
        "method"
      ],
      "properties": {
        "sourceKind": {
          "enum": [
            "observed",
            "measured",
            "declared-assumed",
            "inferred"
          ]
        },
        "analyzer": {
          "type": "string",
          "minLength": 1
        },
        "analyzerVersion": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "measurement": {
      "type": "object",
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "scope",
        "summary",
        "provenance",
        "locations",
        "measurements",
        "tags"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/location"
          }
        },
        "measurements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/measurement"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  }
}
