{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eh:schema:v1:rate-card-model",
  "title": "EffortHours bundled rate-card model v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "version",
    "status",
    "name",
    "currency",
    "effectiveDate",
    "geography",
    "role",
    "hourlyRate",
    "marketRange",
    "formula",
    "wagePoints",
    "sources",
    "assumptions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "currency": {
      "const": "USD"
    },
    "effectiveDate": {
      "type": "string",
      "format": "date"
    },
    "geography": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "hourlyRate": {
      "type": "number",
      "minimum": 0
    },
    "marketRange": {
      "$ref": "urn:eh:schema:v1:rate-card#/$defs/rateRange"
    },
    "formula": {
      "$ref": "#/$defs/formula"
    },
    "wagePoints": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/wagePoint"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "formula": {
      "type": "object",
      "required": [
        "expression",
        "totalCompensationPerHour",
        "wagesAndSalariesPerHour",
        "compensationLoad",
        "billableUtilization",
        "roundingIncrement"
      ],
      "properties": {
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "totalCompensationPerHour": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "wagesAndSalariesPerHour": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "compensationLoad": {
          "type": "number",
          "minimum": 1
        },
        "billableUtilization": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "roundingIncrement": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "wagePoint": {
      "type": "object",
      "required": [
        "label",
        "percentile",
        "seriesId",
        "wagePerHour",
        "rawBillRate",
        "roundedBillRate"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "percentile": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "seriesId": {
          "type": "string",
          "pattern": "^OEU[A-Z0-9]+$"
        },
        "wagePerHour": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rawBillRate": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "roundedBillRate": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "publisher",
        "title",
        "releaseDate",
        "uri",
        "license"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "releaseDate": {
          "type": "string",
          "format": "date"
        },
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "license": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
