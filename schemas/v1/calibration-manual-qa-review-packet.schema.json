{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eh:schema:v1:calibration-manual-qa-review-packet",
  "title": "EffortHours candidate-blind manual-QA development review packet v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "authoringVersion",
    "status",
    "warning",
    "policy",
    "sourceCorpus",
    "rubric",
    "candidateVisibility",
    "sourceRecordId",
    "repository",
    "source",
    "profile",
    "baselineId",
    "partition",
    "targets",
    "instructions"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "authoringVersion": { "type": "string", "minLength": 1 },
    "status": { "const": "unreviewed" },
    "warning": { "type": "string", "minLength": 1 },
    "policy": { "$ref": "#/$defs/policyReference" },
    "sourceCorpus": { "$ref": "#/$defs/corpusReference" },
    "rubric": { "$ref": "#/$defs/rubric" },
    "candidateVisibility": { "const": "blind" },
    "sourceRecordId": { "type": "string", "minLength": 1 },
    "repository": { "$ref": "#/$defs/repository" },
    "source": { "$ref": "#/$defs/source" },
    "profile": { "const": "implementation" },
    "baselineId": { "type": "string", "minLength": 1 },
    "partition": { "const": "development" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/target" }
    },
    "instructions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "policyReference": {
      "type": "object",
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "corpusReference": {
      "type": "object",
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "rubric": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "required": ["id", "name", "sourceDigest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "sourceDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "dataClassification",
        "sourceReference",
        "revision",
        "licenseExpression",
        "redistributionAllowed"
      ],
      "properties": {
        "dataClassification": { "const": "public-redistributable" },
        "sourceReference": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "licenseExpression": { "type": "string", "minLength": 1 },
        "redistributionAllowed": { "const": true }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": [
        "sourceTargetId",
        "sourceLineageDigest",
        "sourceCategory",
        "title",
        "scope",
        "overlapGroupId",
        "evidenceIds"
      ],
      "properties": {
        "sourceTargetId": { "type": "string", "minLength": 1 },
        "sourceLineageDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "sourceCategory": { "$ref": "#/$defs/category" },
        "title": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "overlapGroupId": { "type": "string", "minLength": 1 },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "category": {
      "enum": [
        "production-implementation",
        "ui-implementation-and-represented-ux-decisions",
        "data-modeling-persistence-and-migrations",
        "external-integrations-and-protocols",
        "unit-testing",
        "integration-contract-and-component-testing",
        "end-to-end-and-ui-testing",
        "build-configuration-and-developer-tooling",
        "ci-cd-and-infrastructure-as-code",
        "security-and-accessibility",
        "packaging-deployment-and-release-artifacts"
      ]
    }
  }
}
