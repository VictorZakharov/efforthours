{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eh:schema:v1:change-portfolio-bucket-manifest",
  "title": "EffortHours change portfolio bucket manifest v1",
  "type": "object",
  "required": ["schemaVersion", "buckets"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "buckets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": { "$ref": "#/$defs/bucket" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "publicId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "bucket": {
      "type": "object",
      "required": ["id", "label", "sinceInclusive", "untilExclusive"],
      "properties": {
        "id": { "$ref": "#/$defs/publicId" },
        "label": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sinceInclusive": { "type": "string", "format": "date-time" },
        "untilExclusive": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  }
}
