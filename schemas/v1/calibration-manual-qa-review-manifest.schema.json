{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eh:schema:v1:calibration-manual-qa-review-manifest",
  "title": "EffortHours manual-QA development review packet manifest v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "manifestVersion",
    "authoringVersion",
    "policy",
    "sourceCorpus",
    "rubric",
    "candidateVisibility",
    "partition",
    "recordCount",
    "targetCount",
    "packets",
    "instructions"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "manifestVersion": { "type": "string", "minLength": 1 },
    "authoringVersion": { "type": "string", "minLength": 1 },
    "policy": { "$ref": "#/$defs/policyReference" },
    "sourceCorpus": { "$ref": "#/$defs/corpusReference" },
    "rubric": { "$ref": "#/$defs/rubric" },
    "candidateVisibility": { "const": "blind" },
    "partition": { "const": "development" },
    "recordCount": { "type": "integer", "minimum": 1 },
    "targetCount": { "type": "integer", "minimum": 1 },
    "packets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/packet" }
    },
    "instructions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "policyReference": {
      "type": "object",
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "corpusReference": {
      "type": "object",
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "rubric": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "packet": {
      "type": "object",
      "required": [
        "sourceRecordId",
        "repositoryId",
        "repositorySourceDigest",
        "fileName",
        "packetDigest",
        "lineageDigest",
        "targetCount"
      ],
      "properties": {
        "sourceRecordId": { "type": "string", "minLength": 1 },
        "repositoryId": { "type": "string", "minLength": 1 },
        "repositorySourceDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "fileName": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*\\.manual-qa-review\\.json$"
        },
        "packetDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "lineageDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "targetCount": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  }
}
