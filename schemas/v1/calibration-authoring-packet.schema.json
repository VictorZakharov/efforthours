{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eh:schema:v1:calibration-authoring-packet",
  "title": "EffortHours unreviewed calibration authoring packet v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "authoringVersion",
    "status",
    "warning",
    "rubric",
    "repository",
    "profile",
    "baselineId",
    "candidateVisibility",
    "candidate",
    "targets",
    "professionalizationGapWorkItemIds",
    "instructions"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "authoringVersion": { "type": "string", "minLength": 1 },
    "status": { "const": "unreviewed" },
    "warning": { "type": "string", "minLength": 1 },
    "rubric": { "$ref": "#/$defs/rubric" },
    "repository": { "$ref": "#/$defs/repository" },
    "change": { "$ref": "#/$defs/change" },
    "profile": { "$ref": "#/$defs/profile" },
    "baselineId": { "type": "string", "minLength": 1 },
    "candidateVisibility": { "enum": ["reference", "blind"] },
    "candidate": { "$ref": "#/$defs/candidate" },
    "targets": {
      "type": "array",
      "items": { "$ref": "#/$defs/target" }
    },
    "professionalizationGapWorkItemIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "instructions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "rubric": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "required": ["id", "name", "sourceDigest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "sourceDigest": { "type": "string", "pattern": "^sha256:.+" }
      },
      "additionalProperties": false
    },
    "change": {
      "type": "object",
      "required": [
        "id",
        "selectionKind",
        "baseObjectId",
        "headObjectId",
        "baseEvidenceDigest",
        "headEvidenceDigest",
        "finalDeltaDigest",
        "coverageTags"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "selectionKind": { "enum": ["base-head", "commit", "range", "pull-request"] },
        "baseObjectId": { "type": "string", "minLength": 1 },
        "headObjectId": { "type": "string", "minLength": 1 },
        "baseEvidenceDigest": { "type": "string", "pattern": "^sha256:.+" },
        "headEvidenceDigest": { "type": "string", "pattern": "^sha256:.+" },
        "finalDeltaDigest": { "type": "string", "pattern": "^sha256:.+" },
        "coverageTags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": ["estimatorVersion", "estimateDigest", "totalHours", "categories"],
      "properties": {
        "estimatorVersion": { "type": "string", "minLength": 1 },
        "estimateDigest": { "type": "string", "pattern": "^sha256:.+" },
        "totalHours": {
          "oneOf": [
            { "$ref": "#/$defs/effortRange" },
            { "type": "null" }
          ]
        },
        "categories": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/categoryEstimate" }
        }
      },
      "additionalProperties": false
    },
    "categoryEstimate": {
      "type": "object",
      "required": ["category", "hours"],
      "properties": {
        "category": { "$ref": "#/$defs/category" },
        "hours": { "$ref": "#/$defs/effortRange" }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": [
        "id",
        "sourceCapabilityId",
        "category",
        "title",
        "scope",
        "sourceWorkItemIds",
        "evidenceIds",
        "candidate",
        "review",
        "assumptions",
        "exclusions",
        "uncertaintyReasons"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sourceCapabilityId": { "type": "string", "minLength": 1 },
        "category": { "$ref": "#/$defs/category" },
        "title": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "sourceWorkItemIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "candidate": { "$ref": "#/$defs/suggestion" },
        "review": { "$ref": "#/$defs/review" },
        "assumptions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "exclusions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "uncertaintyReasons": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "suggestion": {
      "type": "object",
      "required": ["hours", "confidence", "reason"],
      "properties": {
        "hours": {
          "oneOf": [
            { "$ref": "#/$defs/effortRange" },
            { "type": "null" }
          ]
        },
        "confidence": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": ["hours", "rationale", "sizeException"],
      "properties": {
        "hours": {
          "oneOf": [
            { "$ref": "#/$defs/effortRange" },
            { "type": "null" }
          ]
        },
        "rationale": { "type": ["string", "null"], "minLength": 1 },
        "sizeException": { "type": ["string", "null"], "minLength": 1 }
      },
      "additionalProperties": false
    },
    "effortRange": {
      "type": "object",
      "required": ["low", "expected", "high"],
      "properties": {
        "low": { "type": "number", "minimum": 0 },
        "expected": { "type": "number", "minimum": 0 },
        "high": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "profile": { "enum": ["implementation", "recreation"] },
    "category": {
      "enum": [
        "specification-comprehension-and-domain-learning",
        "repository-and-solution-setup",
        "architecture-and-technical-design",
        "production-implementation",
        "ui-implementation-and-represented-ux-decisions",
        "data-modeling-persistence-and-migrations",
        "external-integrations-and-protocols",
        "unit-testing",
        "integration-contract-and-component-testing",
        "end-to-end-and-ui-testing",
        "manual-validation-debugging-and-hardening",
        "documentation",
        "build-configuration-and-developer-tooling",
        "ci-cd-and-infrastructure-as-code",
        "security-and-accessibility",
        "packaging-deployment-and-release-artifacts",
        "self-review-and-system-integration"
      ]
    }
  }
}
